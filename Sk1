                    local function digit(b, ox, oy, oz, d, h, col)
                        local w, t = h * 0.55, h * 0.14
                        local sg = {
                            [1] = {b = true, c = true},
                            [2] = {a = true, b = true, g = true, e = true, d = true},
                            [3] = {a = true, b = true, g = true, c = true, d = true},
                            [4] = {f = true, g = true, b = true, c = true},
                        }
                        local s = sg[d]
                        local function hs(yc) box(b, ox, yc - t / 2, oz, w - t, t, 0.25, col, Enum.Material.Neon) end
                        local function vs(xc, yc) box(b, ox + xc, yc - (h / 2 - t) / 2, oz, t, h / 2 - t, 0.25, col, Enum.Material.Neon) end
                        if s.a then hs(oy + h / 2 - t / 2) end
                        if s.g then hs(oy) end
                        if s.d then hs(oy - h / 2 + t / 2) end
                        if s.b then vs(w / 2 - t / 2, oy + h / 4) end
                        if s.c then vs(w / 2 - t / 2, oy - h / 4) end
                        if s.f then vs(-(w / 2 - t / 2), oy + h / 4) end
                        if s.e then vs(-(w / 2 - t / 2), oy - h / 4) end
