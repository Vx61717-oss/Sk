local QueueSkyScriptAfterTeleport
do
    -- 🔒 الطابور يبقى موجود لين يصير انتقال فعلي، فلو نضيف نسخة مع كل ضغطة (حتى لو الانتقال فشل)
    -- كل النسخ تتراكم وتشتغل مرة وحدة عند أول انتقال. لذلك نضيف نسخة وحدة بس لكل جلسة.
    local alreadyQueued = false
    QueueSkyScriptAfterTeleport = function(cancel)
        if cancel then
            -- الانتقال فشل فعلياً: نمسح الطابور (لو المنفّذ يدعم ذلك) عشان ما يشتغل السكربت لوحده بعدين
            local clearQueue = clear_teleport_queue or clearteleportqueue
            if type(clearQueue) == "function" then
                if pcall(clearQueue) then alreadyQueued = false end
            end
            return
        end
        if alreadyQueued then return true end
        local queueTeleport = queue_on_teleport or queueonteleport or (syn and syn.queue_on_teleport)
        if type(queueTeleport) ~= "function" then
            return false
        end

        local ok = pcall(function()
            queueTeleport(SKY_TELEPORT_LOADER)
        end)
        if ok then alreadyQueued = true end
        return ok
    end
end

