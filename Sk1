                                        local c = q[head]
                                        head = head + 1
                                        sizes[n] = sizes[n] + 1
                                        for _, d in ipairs(DIRS) do
                                            local nx, ny = c[1] + d[1], c[2] + d[2]
                                            if nx >= 2 and nx <= COLS - 1 and ny >= 2 and ny <= ROWS - 1 and not g[ny][nx] and not comp[ny][nx] then
                                                comp[ny][nx] = n
                                                q[#q + 1] = {nx, ny}
                                            end
                                        end
                                    end
                                end
                            end
                        end
                        return comp, sizes, n
