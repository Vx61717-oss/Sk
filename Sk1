                                        local m = getMark(used)
                                        m.f.Visible = true
                                        m.f.Size = UDim2.new(0, sz, 0, sz)
                                        m.f.Position = UDim2.new(0, nearPos.X, 0, math.max(sz * 0.6, nearPos.Y))
                                        m.stroke.Color = z.boss and Color3.fromRGB(255, 200, 60) or Color3.fromRGB(255, 60, 60)
                                    elseif dir then
