                ambientMonsterAudio.pickGap = function() -- (حقل مو local: عشان ما نتعدى حد المتغيرات بالدالة)
                    local r = math.random(1, 100)
                    if r <= 30 then return 3 + math.random() * 1.5   -- يتكلم بسرعة (3 لين 4.5 ثانية)
                    elseif r <= 70 then return 6 + math.random() * 4  -- عادي (6 لين 10)
