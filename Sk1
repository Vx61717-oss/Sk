        -- 🛣️ بناء الحلبة من نقاط التحكم (منحنى سلس مقفل)
        local function buildTrack(scene, map)
            local pts, n, S = map.pts, #map.pts, 8
            local T = {x = {}, z = {}, dx = {}, dz = {}, nx = {}, nz = {}, sl = {}, len = 0}
            local N = 0
            for i = 1, n do
                local p0, p1, p2, p3 = pts[(i - 2) % n + 1], pts[i], pts[i % n + 1], pts[(i + 1) % n + 1]
                for k = 0, S - 1 do
                    local t = k / S
                    local t2, t3 = t * t, t * t * t
                    N = N + 1
                    T.x[N] = 0.5 * ((2 * p1[1]) + (-p0[1] + p2[1]) * t + (2 * p0[1] - 5 * p1[1] + 4 * p2[1] - p3[1]) * t2 + (-p0[1] + 3 * p1[1] - 3 * p2[1] + p3[1]) * t3)
                    T.z[N] = 0.5 * ((2 * p1[2]) + (-p0[2] + p2[2]) * t + (2 * p0[2] - 5 * p1[2] + 4 * p2[2] - p3[2]) * t2 + (-p0[2] + 3 * p1[2] - 3 * p2[2] + p3[2]) * t3)
                end
            end
            T.N = N
            local function w(i) return (i - 1) % N + 1 end
            T.w = w
            for i = 1, N do
                local a, b = w(i - 1), w(i + 1)
                local dx, dz = T.x[b] - T.x[a], T.z[b] - T.z[a]
                local l = math.sqrt(dx * dx + dz * dz)
                T.dx[i], T.dz[i] = dx / l, dz / l
                T.nx[i], T.nz[i] = T.dz[i], -T.dx[i]
                local ex, ez = T.x[b] - T.x[i], T.z[b] - T.z[i]
                T.sl[i] = math.sqrt(ex * ex + ez * ez)
                T.len = T.len + T.sl[i]
            end
            T.avg = T.len / N

            local minX, maxX, minZ, maxZ = 1e9, -1e9, 1e9, -1e9
            for i = 1, N do
                minX, maxX = math.min(minX, T.x[i]), math.max(maxX, T.x[i])
                minZ, maxZ = math.min(minZ, T.z[i]), math.max(maxZ, T.z[i])
            end
            T.minX, T.maxX, T.minZ, T.maxZ = minX, maxX, minZ, maxZ
            T.cx, T.cz = (minX + maxX) / 2, (minZ + maxZ) / 2

            mkPart(scene, Vector3.new(1600, 0.1, 1600), map.ground, CFrame.new(T.cx, -0.15, T.cz))
            for i = 1, N do
                local j = w(i + 1)
                local ax, az, bx, bz = T.x[i], T.z[i], T.x[j], T.z[j]
                local mx, mz = (ax + bx) / 2, (az + bz) / 2
                local len = T.sl[i]
                local sdx, sdz = (bx - ax) / len, (bz - az) / len
                mkPart(scene, Vector3.new(TRACK_W, 0.1, len + 1.2), map.road, CFrame.lookAt(Vector3.new(mx, -0.05, mz), Vector3.new(bx, -0.05, bz)))
                local kc = (i % 2 == 0) and Color3.fromRGB(220, 40, 40) or Color3.new(1, 1, 1)
                for _, s in ipairs({-1, 1}) do
                    local kx, kz = mx + sdz * s * (TRACK_W / 2 + 0.6), mz - sdx * s * (TRACK_W / 2 + 0.6)
                    mkPart(scene, Vector3.new(1.2, 0.12, len + 0.2), kc, CFrame.lookAt(Vector3.new(kx, 0.01, kz), Vector3.new(kx + sdx, 0.01, kz + sdz)))
                end
                if i % 2 == 0 then
                    mkPart(scene, Vector3.new(0.4, 0.12, len * 0.5), Color3.fromRGB(235, 235, 235), CFrame.lookAt(Vector3.new(mx, 0.01, mz), Vector3.new(mx + sdx, 0.01, mz + sdz)))
                end
            end

            -- 🏁 خط البداية
            local sc = CFrame.lookAt(Vector3.new(T.x[1], 0.02, T.z[1]), Vector3.new(T.x[1] + T.dx[1], 0.02, T.z[1] + T.dz[1]))
            mkPart(scene, Vector3.new(TRACK_W, 0.12, 3), Color3.new(1, 1, 1), sc)
            for _, lx in ipairs({-0.4, -0.2, 0, 0.2, 0.4}) do
                mkPart(scene, Vector3.new(TRACK_W * 0.1, 0.14, 1.5), BLACK, sc * CFrame.new(lx * TRACK_W, 0, 0.75))
            end
            for _, lx in ipairs({-0.3, -0.1, 0.1, 0.3}) do
                mkPart(scene, Vector3.new(TRACK_W * 0.1, 0.14, 1.5), BLACK, sc * CFrame.new(lx * TRACK_W, 0, -0.75))
            end
            mkPart(scene, Vector3.new(0.8, 9, 0.8), Color3.fromRGB(90, 90, 100), sc * CFrame.new(-(TRACK_W / 2 + 1.5), 4.5, 0))
            mkPart(scene, Vector3.new(0.8, 9, 0.8), Color3.fromRGB(90, 90, 100), sc * CFrame.new(TRACK_W / 2 + 1.5, 4.5, 0))
            mkPart(scene, Vector3.new(TRACK_W + 4, 1.6, 0.8), Color3.fromRGB(230, 40, 40), sc * CFrame.new(0, 9.4, 0), Enum.Material.Neon)

            -- 🌳 الديكور حسب الماب
            local function clear(px, pz, dmin)
                for i = 1, N, 2 do
                    local dx, dz = px - T.x[i], pz - T.z[i]
                    if dx * dx + dz * dz < dmin * dmin then return false end
                end
                return true
            end
            local UP = CFrame.Angles(0, 0, math.pi / 2)
            for i = 1, N, 3 do
                for _, s in ipairs({-1, 1}) do
                    if map.prop == "city" then
                        local lx, lz = T.x[i] + T.nx[i] * s * (TRACK_W / 2 + 3), T.z[i] + T.nz[i] * s * (TRACK_W / 2 + 3)
                        mkPart(scene, Vector3.new(0.3, 7, 0.3), Color3.fromRGB(51, 55, 74), CFrame.new(lx, 3.5, lz))
                        mkPart(scene, Vector3.new(0.9, 0.3, 0.9), Color3.fromRGB(255, 233, 168), CFrame.new(lx, 7.1, lz), Enum.Material.Neon)
                    end
                    local off = TRACK_W / 2 + 14 + math.random() * 30
                    local px, pz = T.x[i] + T.nx[i] * s * off, T.z[i] + T.nz[i] * s * off
                    if clear(px, pz, TRACK_W / 2 + 12) then
                        if map.prop == "city" then
                            local h = 6 + math.random() * 22
                            mkPart(scene, Vector3.new(8 + math.random() * 8, h, 8 + math.random() * 8), Color3.fromRGB(24, 28, 46), CFrame.new(px, h / 2, pz))
                        elseif map.prop == "cactus" then
                            local h = 4 + math.random() * 4
                            mkPart(scene, Vector3.new(h, 1.3, 1.3), Color3.fromRGB(60, 140, 70), CFrame.new(px, h / 2, pz) * UP, nil, Enum.PartType.Cylinder)
