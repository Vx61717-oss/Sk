                        botAggression = 0.75 + math.random() * 0.5,
                        preferredLane = (math.random() - 0.5) * 8,
                        laneTarget = 0, laneThinkAt = 0,
                        nextMistake = 18 + math.random() * 18, mistakeUntil = 0,
                        nextBoost = 4 + math.random() * 5, boostUntil = 0}
                    c.m = buildCaprice(color, kind == "bot" and math.random() < 0.15)
                    c.m.Parent = scene
                    local d = Instance.new("Frame")
                    d.Size = UDim2.new(0, 7, 0, 7)
                    d.BackgroundColor3 = (kind == "me") and Color3.fromRGB(255, 230, 60) or (kind == "human" and Color3.fromRGB(80, 220, 255) or Color3.fromRGB(255, 90, 90))
                    d.BorderSizePixel = 0
                    d.ZIndex = Z + 7
                    d.Parent = minimap
                    Instance.new("UICorner", d).CornerRadius = UDim.new(1, 0)
                    c.dot = d
                    -- مكانه في الشبكة خلف خط البداية
                    -- كل الصفوف خلف خط البداية بمسافة بالأمتار (مع تدرّج على المسار)، والصف الثاني متأخر شوي (ترتيب شبكة)
                    local row = math.floor(slot / 2)
                    local side = (slot % 2 == 0) and -1 or 1
                    local rem = 9 + row * 12 + ((side == 1) and 5 or 0)
                    local k = T.w(0) -- آخر نقطة قبل خط البداية
                    while rem > T.sl[k] do
                        rem = rem - T.sl[k]
                        k = T.w(k - 1)
                    end
                    local k2 = T.w(k + 1)
                    local f = (T.sl[k] - rem) / T.sl[k]
                    local px = T.x[k] + (T.x[k2] - T.x[k]) * f
                    local pz = T.z[k] + (T.z[k2] - T.z[k]) * f
                    local pnx = T.nx[k] + (T.nx[k2] - T.nx[k]) * f
                    local pnz = T.nz[k] + (T.nz[k2] - T.nz[k]) * f
                    local pdx = T.dx[k] + (T.dx[k2] - T.dx[k]) * f
                    local pdz = T.dz[k] + (T.dz[k2] - T.dz[k]) * f
                    c.x = px + pnx * side * 3.6
                    c.z = pz + pnz * side * 3.6
                    c.a = math.atan2(-pdx, -pdz)
                    c.idx = k
                    cars[#cars + 1] = c
                    return c
                end

                -- 🧠 فيزياء مشتركة
                local function stepCar(c, dt, steerLeft, wantMax, nitroOn)
                    local sp = c.v
                    local om = 1.7 * math.min(1, sp / 18) * (1 - math.min(0.35, sp / 300))
                    c.a = c.a + steerLeft * om * dt
                    if sp < wantMax then
                        c.v = math.min(wantMax, sp + (nitroOn and 60 or 32) * dt)
                    else
                        c.v = math.max(wantMax, sp - 25 * dt)
                    end
                    c.x = c.x - math.sin(c.a) * c.v * dt
                    c.z = c.z - math.cos(c.a) * c.v * dt
                    local best, bi = 1e18, c.idx
                    for o = -3, 10 do
                        local j = T.w(c.idx + o)
                        local ddx, ddz = c.x - T.x[j], c.z - T.z[j]
                        local d2 = ddx * ddx + ddz * ddz
                        if d2 < best then best, bi = d2, j end
                    end
                    local prev = c.idx
                    c.idx = bi
                    if prev > N * 0.75 and bi < N * 0.25 then
                        c.lap = c.lap + 1
                    elseif prev < N * 0.25 and bi > N * 0.75 then
                        c.lap = c.lap - 1
                    end
                    local lat = (c.x - T.x[bi]) * T.nx[bi] + (c.z - T.z[bi]) * T.nz[bi]
                    local al = math.abs(lat)
                    c.off_track = al > TRACK_W / 2
                    if c.off_track then
                        c.v = c.v + (math.min(c.v, 26) - c.v) * math.min(1, dt * 3)
                        if al > TRACK_W / 2 + 8 then
                            local s = (lat > 0) and 1 or -1
                            local push = al - (TRACK_W / 2 + 8)
                            c.x = c.x - T.nx[bi] * s * push
                            c.z = c.z - T.nz[bi] * s * push
                            c.v = c.v * 0.97
                        end
                    end
                end

                -- قيادة تلقائية عادية للسيارة بعد انتهاء اللاعب من السباق
                local function autoDrive(c, dt)
                    local look = math.max(2, math.floor((c.v * 0.55 + 12) / T.avg + 0.5))
                    local j = T.w(c.idx + look)
                    local off = c.off + math.sin(raceClock * 0.5 + c.ph) * 1.8
                    local tx, tz = T.x[j] + T.nx[j] * off, T.z[j] + T.nz[j] * off
                    local d = wrapA(math.atan2(-(tx - c.x), -(tz - c.z)) - c.a)
                    local steer = math.clamp(d * 2.5, -1, 1)
                    local targetSpeed = c.maxV * (1 - math.min(0.42, math.abs(d) * 0.9))
                    stepCar(c, dt, steer, targetSpeed, false)
                end

                -- 🧠 ذكاء منافسي البتات: تجاوز، دفاع، ملاحقة، وبوست حسب وضع السباق
                local function botDrive(c, dt)
                    local progress = c.lap * N + c.idx
                    local playerProgress = me and (me.lap * N + me.idx) or progress
                    local gapToPlayer = playerProgress - progress -- موجب = اللاعب متقدم
                    local look = math.max(3, math.floor((c.v * 0.48 + 18) / math.max(1, T.avg) + 0.5))
                    local j = T.w(c.idx + look)

                    -- غيّر المسار إذا اقترب منافس أمامه، وحاول تجاوزه من الجهة الأوسع
                    if raceClock >= (c.laneThinkAt or 0) then
                        c.laneThinkAt = raceClock + 0.28 + math.random() * 0.22
                        local desired = c.preferredLane or 0
                        local nearestAhead, nearestDist, nearestSide = nil, 1e9, 0
                        for _, other in ipairs(cars) do
                            if other ~= c and not other.gone and other.kind ~= "human" then
                                local dx, dz = other.x - c.x, other.z - c.z
                                local dist = math.sqrt(dx * dx + dz * dz)
                                local forward = math.cos(c.a) * -dz + math.sin(c.a) * -dx
                                if forward > 0 and forward < 34 and dist < nearestDist then
                                    nearestAhead, nearestDist = other, dist
                                    local oi = T.w(other.idx)
                                    nearestSide = (other.x - T.x[oi]) * T.nx[oi] + (other.z - T.z[oi]) * T.nz[oi]
                                end
                            end
                        end
                        if nearestAhead and nearestDist < 27 then
                            local myIdx = T.w(c.idx)
                            local mySide = (c.x - T.x[myIdx]) * T.nx[myIdx] + (c.z - T.z[myIdx]) * T.nz[myIdx]
                            local leftRoom = TRACK_W / 2 - math.abs(mySide + 5.2)
                            local rightRoom = TRACK_W / 2 - math.abs(mySide - 5.2)
                            if nearestSide >= mySide then
                                desired = (leftRoom >= rightRoom) and -5.0 or 5.0
                            else
                                desired = (rightRoom >= leftRoom) and 5.0 or -5.0
                            end
                        elseif me and math.abs(gapToPlayer) < N * 0.22 then
                            -- إذا كان قريباً من اللاعب، لا يبقى خلفه في نفس الخط
                            local myIdx = T.w(c.idx)
                            local mySide = (c.x - T.x[myIdx]) * T.nx[myIdx] + (c.z - T.z[myIdx]) * T.nz[myIdx]
                            if math.abs(mySide) < 2.5 then desired = (c.slot % 2 == 0) and -4.8 or 4.8 end
                        elseif math.random() < 0.16 then
                            desired = (math.random() - 0.5) * 9
                        end
                        c.laneTarget = math.clamp(desired, -6.0, 6.0)
                    end
                    c.off = c.off + ((c.laneTarget or 0) - c.off) * math.min(1, dt * 2.8)

                    local tx = T.x[j] + T.nx[j] * c.off
                    local tz = T.z[j] + T.nz[j] * c.off
                    local d = wrapA(math.atan2(-(tx - c.x), -(tz - c.z)) - c.a)
                    local steer = math.clamp(d * 3.0, -1, 1)

                    -- يبطئ قليلاً في المنعطفات الحادة، ويحافظ على السرعة في المستقيمات
                    local cornerFactor = 1 - math.min(0.30, math.abs(d) * 0.62)
                    local targetSpeed = c.maxV * (c.botSkill or 1) * cornerFactor

                    -- أخطاء قيادة خفيفة ونادرة حتى لا يكون كل منافس مثالياً
                    if raceClock >= (c.nextMistake or 999) then
                        c.mistakeUntil = raceClock + 0.45 + math.random() * 0.45
                        c.nextMistake = raceClock + 22 + math.random() * 28
                    end
                    local makingMistake = raceClock < (c.mistakeUntil or 0)
                    if makingMistake then
                        targetSpeed = targetSpeed * 0.84
                        steer = math.clamp(steer + math.sin(raceClock * 8 + c.ph) * 0.12, -1, 1)
                    end

                    -- بوست تكتيكي: للحاق باللاعب أو للهجوم عند الاقتراب من منافس
                    local nearRival, straight = false, math.abs(d) < 0.20
                    for _, other in ipairs(cars) do
                        if other ~= c and not other.gone and other.kind ~= "human" then
                            local dx, dz = other.x - c.x, other.z - c.z
                            local dist = math.sqrt(dx * dx + dz * dz)
                            local forward = math.cos(c.a) * -dz + math.sin(c.a) * -dx
                            if forward > 4 and forward < 30 and dist < 32 then nearRival = true; break end
                        end
                    end
                    local chasingPlayer = me and gapToPlayer > 0 and gapToPlayer < N * 0.42
                    local defendingLead = me and gapToPlayer < 0 and gapToPlayer > -N * 0.16
                    if raceClock >= (c.nextBoost or 0) then
                        local wantsBoost = (chasingPlayer and math.random() < 0.78)
                            or (nearRival and math.random() < 0.72)
                            or (straight and math.random() < 0.38)
                            or (defendingLead and math.random() < 0.42)
                        if wantsBoost then
                            c.boostUntil = raceClock + 1.8 + math.random() * 1.5
                            c.nextBoost = raceClock + 5.0 + math.random() * 5.5
                        else
                            c.nextBoost = raceClock + 1.2 + math.random() * 2.0
                        end
                    end
                    local boosting = raceClock < (c.boostUntil or 0)
                    if boosting then targetSpeed = targetSpeed + 18 * (c.botAggression or 1) end
                    stepCar(c, dt, steer, targetSpeed, boosting)
                end

                local function collide(a, b, bothMove)
                    local dx, dz = b.x - a.x, b.z - a.z
                    local d = math.sqrt(dx * dx + dz * dz)
                    if d < 3.4 and d > 0.001 then
                        local push = (3.4 - d) / 2
                        local ux, uz = dx / d, dz / d
                        a.x, a.z = a.x - ux * push, a.z - uz * push
                        a.v = a.v * 0.99
                        if bothMove then
                            b.x, b.z = b.x + ux * push, b.z + uz * push
                            b.v = b.v * 0.99
                        end
                    end
                end

                -- 🏆 الترتيب
                local function score(c)
                    if c.ft then return 1e6 - c.ft end
                    return c.lap * N + c.idx
                end
                local function rankList()
                    local l = {}
                    for _, c in ipairs(cars) do
                        if not c.gone then l[#l + 1] = c end
                    end
                    table.sort(l, function(p, q) return score(p) > score(q) end)
                    return l
                end
                local function resultsText()
                    local lines = {}
                    for i, c in ipairs(rankList()) do
                        local info = c.ft and string.format("%.1f ث", c.ft) or ("لفة " .. math.clamp(c.lap, 1, map.laps))
                        lines[#lines + 1] = i .. ". " .. c.name .. "  " .. info .. (c.isMe and "  ⭐" or "")
                    end
                    return table.concat(lines, "\n")
                end

                -- 🌐 المزامنة
                local function r1(v) return math.floor(v * 10 + 0.5) / 10 end
                task.spawn(function()
                    while running do
                        if state ~= "menu" and lobbyKey then
                            local e = {lb = lobbyKey, n = myName, c = colIdx, t = os.time(), ft = 0, x = 0, z = 0, a = 0, v = 0, l = 0, i = 1}
                            if me then
                                e.x, e.z, e.a, e.v = r1(me.x), r1(me.z), r1(me.a), r1(me.v)
                                e.l, e.i, e.ft = me.lap, me.idx, me.ft or 0
                            end
                            fbCall("PUT", "players/" .. myId, e)
                        end
                        task.wait(0.3)
                    end
                end)
                task.spawn(function()
                    while running do
                        if state ~= "menu" and lobbyKey then
                            local d, ok = fbCall("GET", "players")
                            if ok and type(d) == "table" then snap = d end
                        end
                        task.wait(0.5)
                    end
                end)
                deleteMine = function() fbCall("DELETE", "players/" .. myId) end

                local function activeHumans()
                    local list = {}
                    local nowT = os.time()
                    for id, d in pairs(snap) do
                        if id ~= myId and type(d) == "table" and d.lb == lobbyKey and nowT - (tonumber(d.t) or 0) < 12 then
                            list[#list + 1] = {id = id, d = d}
                        end
                    end
                    return list
                end

                -- ▶️ بداية السباق
                local function beginCount()
                    state = "count"
                    goAt = os.clock() + 3 -- ⏱️ عد تنازلي فعلي 3 ثواني قبل ما تبدأ الجولة
                    cdLbl.Text = "3"
                    panel.Visible = false
                    setupMap(mapIdx) -- يعيد بناء الماب وينظف السيارات القديمة
                    local hum = {{id = myId, me = true}}
                    if raceMode == "players" then
                        for _, h in ipairs(activeHumans()) do
                            if #hum < 8 then hum[#hum + 1] = h end
                        end
                    end
                    table.sort(hum, function(p, q) return p.id < q.id end)
                    -- 🏁 نجمع كل المتسابقين (لاعبين + بتات) ونوزعهم عشوائياً على صفوف خط البداية
                    local entries = {}
                    for _, h in ipairs(hum) do entries[#entries + 1] = {h = h} end
                    local used = {}
                    for k = 1, ((raceMode == "pets") and math.max(0, TOTAL - #hum) or 0) do
                        local nm
                        repeat nm = BOT_NAMES[math.random(1, #BOT_NAMES)] until not used[nm]
                        used[nm] = true
                        entries[#entries + 1] = {bot = nm}
                    end
                    -- خلط مبني على رقم اللوبي: كل اللاعبين يطلع عندهم نفس الترتيب، ومكانك يتغير كل سباق
                    local rng = Random.new(tonumber(lobby and lobby.id) or os.time())
                    for i = #entries, 2, -1 do
                        local j = rng:NextInteger(1, i)
                        entries[i], entries[j] = entries[j], entries[i]
                    end
                    for slot, e in ipairs(entries) do
                        if e.bot then
                            newCar("bot", e.bot, OBS_COLORS[math.random(1, #OBS_COLORS)], slot - 1)
                        elseif e.h.me then
                            me = newCar("me", myName, CAR_COLORS[colIdx], slot - 1)
                            me.maxV = 66
                        else
                            local c = newCar("human", tostring(e.h.d.n or "لاعب"), CAR_COLORS[math.clamp(tonumber(e.h.d.c) or 1, 1, #CAR_COLORS)], slot - 1)
                            c.id = e.h.id
                        end
                    end
                    camYaw = me.a
                    bannerShown = false
                    banner.Text = ""
                    nitro = 100
                    pcall(function() if _G.SkyGameAudio then _G.SkyGameAudio.Begin("race", "action") end end)
                end

                local function startFlow()
                    state = "wait"
                    showPanel("wait")
                    pMap.Text = "الماب: " .. map.name
                    pMsg.Text = "جاري البحث عن سباق..."
                    task.spawn(function()
                        local lb, ok = fbCall("GET", "lobby")
                        local now = os.time()
                        if ok and type(lb) == "table" and tostring(lb.mode or "players") == raceMode and tonumber(lb.start) and tonumber(lb.start) > now - 1 and MAPS[tonumber(lb.map)] then
                            lobby = {start = tonumber(lb.start), map = tonumber(lb.map), id = tostring(lb.id), mode = raceMode}
                        else
                            lobby = {start = now + (ok and WAIT or 1), map = mapIdx, id = tostring(math.random(100000, 999999)), host = true, mode = raceMode}
                            if ok then fbCall("PUT", "lobby", {start = lobby.start, map = lobby.map, id = lobby.id, mode = raceMode}) end
                        end
                        if not running then return end
                        lobbyKey = tostring(lobby.start) .. "_" .. lobby.id
                        if lobby.map ~= mapIdx then setupMap(lobby.map) end
                        pMap.Text = "الماب: " .. map.name
                    end)
                end

                local function toMenu()
                    nextMap = nextMap % #MAPS + 1
                    state = "menu"
                    lobby, lobbyKey, snap = nil, nil, {}
                    cdLbl.Text, banner.Text = "", ""
                    setupMap(nextMap)
                    showPanel("menu")
                    if deleteMine then task.spawn(deleteMine) end
                end

                goBtn.Activated:Connect(function()
                    if state == "menu" then
                        startFlow()
                    elseif state == "wait" and lobby then
                        lobby.start = os.time()
                        if lobby.host then task.spawn(function() fbCall("PUT", "lobby", {start = lobby.start, map = lobby.map, id = lobby.id, mode = raceMode}) end) end
                    elseif state == "done" then
                        toMenu()
                    end
                end)

                setupMap(nextMap)
                showPanel("menu")

                -- 🔁 اللعبة كل فريم
                local function step(dt)
                    dt = math.min(dt, 0.05)
                    local now = os.time()
                    local camPos, camLook

                    if state == "menu" or state == "wait" then
                        orbit = orbit + dt * 0.15
                        local R = 330
                        camPos = Vector3.new(T.cx + math.cos(orbit) * R, 190, T.cz + math.sin(orbit) * R)
                        camLook = Vector3.new(T.cx, 0, T.cz)
                        cam3d.FieldOfView = 60
                        if state == "wait" and lobby and lobbyKey then
                            local left = lobby.start - now
                            pMsg.Text = (raceMode == "pets") and ("أنت ضد " .. (TOTAL - 1) .. " بتات 🤖\nيبدأ بعد " .. math.max(0, left) .. " ثانية") or ("ترا في أحد يتحداك في لعبة السباقات!\nاللاعبون المشغلون للسكربت: " .. (1 + #activeHumans()) .. "\nيبدأ بعد " .. math.max(0, left) .. " ثانية")
                            if left <= 0 then beginCount() end
                        end
                    else
                        if state == "count" then
                            local left = goAt - os.clock()
                            if left <= 0 then
                                state = "race"
                                raceClock = 0
                                cdLbl.Text = "🏁 انطلق!"
                                task.delay(1, function() if state ~= "count" and cdLbl.Text == "🏁 انطلق!" then cdLbl.Text = "" end end)
                            else
                                cdLbl.Text = tostring(math.ceil(left))
                            end
                        else
                            raceClock = raceClock + dt
                        end

                        if state == "race" or state == "done" then
                            -- 🕹️ لاعبي
                            if me and not me.auto then
                                local target = (hold.l and 1 or 0) - (hold.r and 1 or 0)
                                me.steer = me.steer + (target - me.steer) * math.min(1, dt * 8)
                                local nOn = hold.n and nitro > 0
                                nitro = nOn and math.max(0, nitro - 28 * dt) or math.min(100, nitro + 9 * dt)
                                stepCar(me, dt, me.steer, nOn and 98 or 66, nOn)
                            elseif me then
                                autoDrive(me, dt)
                            end
                            for _, c in ipairs(cars) do
                                if c.kind == "bot" then botDrive(c, dt) end
                            end
                            -- 🌐 اللاعبين الحقيقيين
                            for _, c in ipairs(cars) do
                                if c.kind == "human" then
                                    local d = snap[c.id]
                                    if type(d) == "table" and d.lb == lobbyKey and now - (tonumber(d.t) or 0) < 10 then
                                        c.gone = false
                                        local ta = tonumber(d.a) or c.a
                                        local tv = tonumber(d.v) or 0
                                        local tx = (tonumber(d.x) or c.x) - math.sin(ta) * tv * 0.15
                                        local tz = (tonumber(d.z) or c.z) - math.cos(ta) * tv * 0.15
                                        local k = math.min(1, dt * 8)
                                        c.x, c.z = c.x + (tx - c.x) * k, c.z + (tz - c.z) * k
                                        c.a = c.a + wrapA(ta - c.a) * k
                                        c.v = tv
                                        c.lap, c.idx = tonumber(d.l) or c.lap, tonumber(d.i) or c.idx
                                        local f = tonumber(d.ft)
                                        c.ft = (f and f > 0) and f or nil
                                        if c.m.Parent == nil then c.m.Parent = scene end
                                    else
                                        c.gone = true
                                        c.m.Parent = nil
                                    end
                                end
                            end
                            -- 💥 تصادمات
                            for i = 1, #cars do
                                for j = i + 1, #cars do
                                    local a, b = cars[i], cars[j]
                                    if not a.gone and not b.gone then
                                        if a.kind ~= "human" and b.kind ~= "human" then
                                            collide(a, b, true)
                                        elseif a.kind ~= "human" then
                                            collide(a, b, false)
                                        elseif b.kind ~= "human" then
                                            collide(b, a, false)
                                        end
                                    end
                                end
                            end
                            -- 🏁 خط النهاية
                            for _, c in ipairs(cars) do
                                if c.kind ~= "human" and not c.ft and c.lap > map.laps then
                                    c.ft = raceClock
                                    if c.isMe then
                                        c.auto = true
                                        c.off, c.maxV = 0, 40
                                        state = "done"
                                        task.delay(1.4, function()
                                            if running and state == "done" then
                                                showPanel("done")
                                                local lst = rankList()
                                                local pos = 1
                                                for i, x in ipairs(lst) do if x == me then pos = i end end
                                                pTitle.Text = (pos == 1) and "🏆 فزت بالسباق!" or ("🏁 المركز " .. pos)
                                                pMap.Text = map.name
                                                pMsg.Text = resultsText()
                                            end
                                        end)
                                    end
                                end
                            end
                        end

                        -- 🏆 لوحة الترتيب والبانر
                        rankT = rankT - dt
                        if rankT <= 0 and me then
                            rankT = 0.25
                            local lst = rankList()
                            local lines = {}
                            for i, c in ipairs(lst) do
                                lines[#lines + 1] = (c.isMe and "▶ " or "") .. i .. ". " .. c.name
                                if c.isMe then placeLbl.Text = "المركز " .. i .. "/" .. #lst end
                                if c.ft and not bannerShown then
                                    bannerShown = true
                                    banner.Text = "🏆 الفائز: " .. c.name
                                    task.delay(4, function() if banner.Text:find("🏆") then banner.Text = "" end end)
                                end
                            end
                            boardLbl.Text = table.concat(lines, "\n")
                        end
                        if me then
                            lapLbl.Text = "لفة " .. math.clamp(me.lap, 1, map.laps) .. "/" .. map.laps
                            spLbl.Text = math.floor(me.v * 2.2) .. " كم/س"
                            nFill.Size = UDim2.new(nitro / 100, 0, 1, 0)
                            pcall(function()
                                if _G.SkyGameAudio then _G.SkyGameAudio.SetIntensity(math.floor(me.v / 12)) end
                            end)
                            camYaw = camYaw + wrapA(me.a - camYaw) * math.min(1, dt * 5)
                            local fx, fz = -math.sin(camYaw), -math.cos(camYaw)
                            camPos = Vector3.new(me.x - fx * 9.5, 4.4, me.z - fz * 9.5)
                            camLook = Vector3.new(me.x + fx * 14, 1.2, me.z + fz * 14)
                            cam3d.FieldOfView = 70 + math.clamp((me.v - 30) * 0.4, 0, 24)
                        end
                    end

                    -- 🚗 تحديث المجسمات والخريطة الصغيرة
                    for _, c in ipairs(cars) do
                        local roll = c.isMe and (c.steer * c.v * 0.0006) or 0
                        local carCF = CFrame.new(c.x, 0.65, c.z) * CFrame.Angles(0, c.a, roll)
                        c.m:PivotTo(carCF)
                        if c.isMe then
                            local boostingNow = (state == "race") and hold.n and nitro > 0
                            boostTag.Visible = boostingNow
                            spLbl.TextColor3 = boostingNow and Color3.fromRGB(90, 220, 255) or Color3.new(1, 1, 1)
                            if not c.boostStreaks then
                                c.boostStreaks = {}
                                for si = 1, 3 do
                                    local streak = Instance.new("Part")
                                    streak.Name = "PlayerBoostStreak" .. si
                                    streak.Anchored = true
                                    streak.CanCollide = false
                                    streak.CastShadow = false
                                    streak.Material = Enum.Material.Neon
                                    streak.Color = (si == 2) and Color3.fromRGB(255, 145, 35) or Color3.fromRGB(55, 195, 255)
                                    streak.Transparency = 1
                                    streak.Size = Vector3.new(0.16, 0.16, 2.2)
                                    streak.Parent = scene
                                    c.boostStreaks[si] = streak
                                end
                            end
                            for si, streak in ipairs(c.boostStreaks) do
                                if boostingNow then
                                    local side = (si - 2) * 0.48
                                    local length = 1.8 + math.clamp(c.v / 45, 0, 1.6) + math.random() * 0.35
                                    local offset = CFrame.new(side, 0.12, 3.05 + length * 0.48)
                                    streak.Size = Vector3.new(si == 2 and 0.24 or 0.13, 0.13, length)
                                    streak.CFrame = carCF * offset
                                    streak.Transparency = 0.12 + math.random() * 0.18
                                else
                                    streak.Transparency = 1
                                end
                            end
                        end
                        if T and T.mm then
                            local mx, mz = T.mm(c.x, c.z)
                            c.dot.Position = UDim2.new(0, mx - 3, 0, mz - 3)
                            c.dot.Visible = not c.gone
                        end
                    end
                    if state ~= "race" then
                        boostTag.Visible = false
                        spLbl.TextColor3 = Color3.new(1, 1, 1)
                        if me and me.boostStreaks then
                            for _, streak in ipairs(me.boostStreaks) do streak.Transparency = 1 end
                        end
                    end
                    if camPos then cam3d.CFrame = CFrame.lookAt(camPos, camLook) end
                end

                local errored = false
                connections[#connections + 1] = RunService.RenderStepped:Connect(function(dt)
                    if not running then return end
                    local ok, err = pcall(step, dt)
                    if not ok and not errored then
                        errored = true
                        warn("[Sky] Race step: " .. tostring(err))
                    end
                end)
            end)

            if not okRun then
                warn("[Sky] Race error: " .. tostring(errRun))
                local msg = Instance.new("TextLabel")
                msg.BackgroundTransparency = 1
                msg.Size = UDim2.new(1, 0, 0, 40)
                msg.Position = UDim2.new(0, 0, 0.5, -20)
                msg.Font = Enum.Font.Arcade
                msg.TextSize = 18
                msg.TextColor3 = Color3.fromRGB(255, 120, 120)
                msg.Text = "⚠️ تعذر تشغيل اللعبة، اضغط خروج"
                msg.ZIndex = Z + 5
                msg.Parent = overlay
            end
        end

        -- 🚓 ================= مود مطاردة الشرطة: ماب مدينة كبير + مستويات =================
        local policeBtn = Instance.new("TextButton")
        policeBtn.Size = UDim2.new(1, -20, 0, 36)
        policeBtn.AnchorPoint = Vector2.new(0.5, 1)
        policeBtn.Position = UDim2.new(0.5, 0, 1, -10)
        policeBtn.BackgroundColor3 = Color3.fromRGB(40, 60, 150)
        policeBtn.BorderSizePixel = 0
        policeBtn.AutoButtonColor = false
        policeBtn.Font = Enum.Font.Arcade
        policeBtn.TextSize = 15
        policeBtn.TextColor3 = Color3.new(1, 1, 1)
        policeBtn.Text = "🚓 مطاردة الشرطة (ماب كبير + مستويات)"
        policeBtn.ZIndex = 9
        policeBtn.Parent = section
        Instance.new("UICorner", policeBtn).CornerRadius = UDim.new(0, 8)
        local policeStroke = Instance.new("UIStroke", policeBtn)
        policeStroke.Color = THEME
        policeStroke.Thickness = 1.3

        local policeBest = 1 -- أعلى مستوى وصلت له خلال الجلسة

        local launchPolice
        launchPolice = function()
            if activeGame then activeGame() end

            local connections = {}
            local running, cleaned = true, false
            local overlay = Instance.new("Frame")
            overlay.Name = "PoliceChaseGame"
            overlay.Size = UDim2.new(1, 0, 1, 0)
            overlay.BackgroundColor3 = Color3.fromRGB(18, 20, 45)
            overlay.BorderSizePixel = 0
            overlay.Active = true
            overlay.ClipsDescendants = true
            overlay.ZIndex = Z
            overlay.Parent = ScreenGui

            local function cleanup()
                if cleaned then return end
                cleaned = true
                running = false
                for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
                connections = {}
                pcall(function() if _G.SkyGameAudio then _G.SkyGameAudio.End("race") end end)
                if overlay then pcall(function() overlay:Destroy() end) end
                if activeGame == cleanup then activeGame = nil end
            end
            activeGame = cleanup

            local exitBtn = Instance.new("TextButton")
            exitBtn.Size = UDim2.new(0, 96, 0, 32)
            exitBtn.AnchorPoint = Vector2.new(1, 0)
            exitBtn.Position = UDim2.new(1, -12, 0, 10)
            exitBtn.BackgroundColor3 = Color3.fromRGB(120, 40, 40)
            exitBtn.BorderSizePixel = 0
            exitBtn.AutoButtonColor = false
            exitBtn.Font = Enum.Font.Arcade
            exitBtn.TextSize = 15
            exitBtn.TextColor3 = Color3.new(1, 1, 1)
            exitBtn.Text = "✖ خروج"
            exitBtn.ZIndex = Z + 12
            exitBtn.Parent = overlay
            Instance.new("UICorner", exitBtn).CornerRadius = UDim.new(0, 8)
            exitBtn.Activated:Connect(cleanup)

            local okRun, errRun = pcall(function()
                -- 🗺️ إعدادات الماب: مدينة 11×11 بلوك (حوالي 1000×1000)
                local BLOCKS, BLOCK, ROAD = 11, 62, 26
                local PERIOD = BLOCK + ROAD
                local SIZE = BLOCKS * PERIOD + ROAD
                local HALF = SIZE / 2
                local function roadC(i) return -HALF + i * PERIOD + ROAD / 2 end
                local function wrapA(d) return (d + math.pi) % (2 * math.pi) - math.pi end

                local view3d = Instance.new("ViewportFrame")
                view3d.Name = "PoliceChase3D"
                view3d.Size = UDim2.new(1, 0, 1, 0)
                view3d.BackgroundColor3 = Color3.fromRGB(18, 20, 45)
                view3d.BorderSizePixel = 0
                view3d.Active = false
                view3d.ZIndex = Z + 1
                view3d.Ambient = Color3.fromRGB(135, 140, 175)
                view3d.LightColor = Color3.fromRGB(185, 190, 255)
                view3d.LightDirection = Vector3.new(0.4, -1, -0.3)
                view3d.Parent = overlay
                local cam3d = Instance.new("Camera")
                cam3d.FieldOfView = 70
                cam3d.Parent = view3d
                view3d.CurrentCamera = cam3d
                local scene = Instance.new("Folder")
                scene.Name = "Scene"
                scene.Parent = view3d

                -- 🏙️ بناء المدينة
