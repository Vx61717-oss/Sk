                            altBtn.Text = "كمّل من المستوى " .. policeBest
                        end
                    elseif mode == "won" then
                        pTitle.Text = "✅ تهربت من الشرطة!"
                        pMsg.Text = "خلصت المستوى " .. level .. "\nالمستوى الجاي أصعب شوي: شرطة أكثر وأسرع وأذكى."
                        goBtn.Text = "المستوى " .. (level + 1)
                    else
                        pTitle.Text = "🚨 انمسكت!"
                        pMsg.Text = "وصلت للمستوى " .. level .. "\nأعلى مستوى وصلت له: " .. policeBest
                        goBtn.Text = "حاول مرة ثانية (مستوى " .. level .. ")"
                        if level > 1 then
                            altBtn.Visible = true
                            altBtn.Text = "ابدأ من المستوى 1"
                        end
                    end
                end

                -- 🚓 سيارات الشرطة
                local COP_RED, COP_BLUE = Color3.fromRGB(255, 30, 30), Color3.fromRGB(40, 90, 255)
                local function pickSpot(minD, maxD)
                    local cands = {}
                    for i = 0, BLOCKS do
                        for j = 0, BLOCKS do
                            local x, z = roadC(i), roadC(j)
                            local d = math.sqrt((x - player.x) ^ 2 + (z - player.z) ^ 2)
                            if d >= minD and d <= maxD then cands[#cands + 1] = {x, z} end
                        end
                    end
                    if #cands == 0 then cands[1] = {roadC(math.random(0, BLOCKS)), roadC(math.random(0, BLOCKS))} end
                    local p = cands[math.random(1, #cands)]
                    return p[1], p[2]
                end
                local function placeCop(c, minD, maxD)
                    for _ = 1, 10 do
                        c.x, c.z = pickSpot(minD, maxD)
                        local free = true
                        for _, o in ipairs(police) do
                            if o ~= c and (o.x - c.x) ^ 2 + (o.z - c.z) ^ 2 < 60 * 60 then free = false; break end
                        end
                        if free then break end
                    end
                    -- يبدأ متجه مع الشارع (أقرب اتجاه رئيسي نحو اللاعب) مو بشكل قطري
                    local ex, ez = player.x - c.x, player.z - c.z
                    if math.abs(ex) > math.abs(ez) then
                        c.a = (ex > 0) and -math.pi / 2 or math.pi / 2
                    else
                        c.a = (ez > 0) and math.pi or 0
                    end
                    c.v, c.stuckT, c.revUntil = 0, 0, 0
                    c.wi, c.w2i, c.ma, c.dx, c.dz, c.ndx, c.ndz = nil, nil, nil, 0, 0, 0, 0
                    c.los, c.losT = false, 0
                end
                local function spawnCop(minD, maxD)
                    local c = {v = 0, a = 0, x = 0, z = 0, stuckT = 0, revUntil = 0,
                        flank = 0, avoidSign = (math.random() < 0.5) and -1 or 1,
                        lane = (math.random() - 0.5) * 6, losT = 0, los = false, dx = 0, dz = 0, ndx = 0, ndz = 0,
                        nextBoost = 3 + math.random() * 4, boostUntil = 0,
                        speedVar = 0.94 + math.random() * 0.12}
                    if cfg and cfg.flank and (#police % 2 == 1) then c.flank = (math.random() < 0.5) and -1 or 1 end
                    c.m = buildCaprice(Color3.fromRGB(235, 235, 242), true)
                    c.m.Parent = scene
                    c.lights = {}
                    for _, obj in ipairs(c.m:GetDescendants()) do
                        if obj:IsA("BasePart") and obj.Material == Enum.Material.Neon and math.abs(obj.Size.Y - 0.14) < 0.01 then
                            c.lights[#c.lights + 1] = obj
                        end
                    end
                    c.dot = mkDot(Color3.fromRGB(255, 70, 70), 6)
                    placeCop(c, minD, maxD)
                    police[#police + 1] = c
                    return c
                end
                local function clearPolice()
                    for _, c in ipairs(police) do
                        if c.m then c.m:Destroy() end
                        if c.dot then c.dot:Destroy() end
                    end
                    police = {}
                end

                local function stepDrive(c, dt, steer, wantMax, nitroOn, turnMul, drift)
                    local sp = c.v
                    if not c.ma then c.ma = c.a end
                    local om = 1.8 * turnMul * math.min(1, sp / 16) * (1 - math.min(0.4, math.abs(sp) / 260))
                    c.a = c.a + steer * om * dt
                    if sp < wantMax then
                        c.v = math.min(wantMax, sp + (nitroOn and 62 or 30) * dt)
                    else
                        c.v = math.max(wantMax, sp - 28 * dt)
                    end
                    -- اتجاه الحركة يلحق اتجاه السيارة (في التفحيط يتأخر كثير فتنزلق)
                    c.ma = c.ma + wrapA(c.a - c.ma) * math.min(1, dt * (drift and 3.2 or 12))
                    local slip = wrapA(c.a - c.ma)
                    if slip > 0.8 then c.a = c.ma + 0.8 elseif slip < -0.8 then c.a = c.ma - 0.8 end
                    c.x = c.x - math.sin(c.ma) * c.v * dt
                    c.z = c.z - math.cos(c.ma) * c.v * dt
                end

                local function nearIdx(v)
                    return math.clamp(math.floor((v + HALF - ROAD / 2) / PERIOD + 0.5), 0, BLOCKS)
                end
                local function losClear(x1, z1, x2, z2, margin)
                    local dx, dz = x2 - x1, z2 - z1
                    local n = math.max(1, math.floor(math.sqrt(dx * dx + dz * dz) / 5))
                    for k = 1, n do
                        local t = k / n
                        if blockedAt(x1 + dx * t, z1 + dz * t, margin) then return false end
                    end
                    return true
                end
                -- 🧭 الخطوة الجاية على شبكة الشوارع باتجاه التقاطع الهدف
                local function routeStep(c, ti, tj)
                    local i1, j1 = c.wi, c.wj
                    local pdx, pdz = c.dx or 0, c.dz or 0
                    local curDist = math.abs(ti - i1) + math.abs(tj - j1)
                    local best, bestScore
                    for _, d in ipairs({{1, 0}, {-1, 0}, {0, 1}, {0, -1}}) do
                        local ni, nj = i1 + d[1], j1 + d[2]
                        local isReverse = (pdx ~= 0 or pdz ~= 0) and d[1] == -pdx and d[2] == -pdz
                        if ni >= 0 and ni <= BLOCKS and nj >= 0 and nj <= BLOCKS and not isReverse then
                            local nd = math.abs(ti - ni) + math.abs(tj - nj)
                            local score = nd + math.random() * 0.9
                            if d[1] == pdx and d[2] == pdz then
                                -- يكمل على نفس الشارع فقط إذا يقرّبه من الهدف (بدون دورانات 180°)
                                if nd < curDist then score = score - 0.35 else score = score + 0.5 end
                            end
                            if not bestScore or score < bestScore then bestScore, best = score, d end
                        end
                    end
                    if not best then best = {-pdx, -pdz} end
                    return i1 + best[1], j1 + best[2], best[1], best[2]
                end

                -- يحدد أول نقطة في المسار بناءً على الشارع اللي واقف عليه واتجاهه (عشان ما يقطع بين المباني)
                local function initPath(c, ti, tj)
                    local ri, rj = nearIdx(c.x), nearIdx(c.z)
                    local onV = math.abs(c.x - roadC(ri)) < ROAD / 2 - 1
                    local onH = math.abs(c.z - roadC(rj)) < ROAD / 2 - 1
                    local hx, hz = -math.sin(c.a), -math.cos(c.a)
                    c.wi, c.wj, c.dx, c.dz = ri, rj, 0, 0
                    if onV and not onH then
                        local dir = (hz >= 0) and 1 or -1
                        local jj
                        if dir > 0 then
                            jj = math.ceil((c.z + 2 + HALF - ROAD / 2) / PERIOD)
                        else
                            jj = math.floor((c.z - 2 + HALF - ROAD / 2) / PERIOD)
                        end
                        c.wj = math.clamp(jj, 0, BLOCKS)
                        c.dx, c.dz = 0, dir
                    elseif onH and not onV then
                        local dir = (hx >= 0) and 1 or -1
                        local ii
                        if dir > 0 then
                            ii = math.ceil((c.x + 2 + HALF - ROAD / 2) / PERIOD)
                        else
                            ii = math.floor((c.x - 2 + HALF - ROAD / 2) / PERIOD)
                        end
                        c.wi = math.clamp(ii, 0, BLOCKS)
                        c.dx, c.dz = dir, 0
                    end
                    c.w2i, c.w2j, c.ndx, c.ndz = routeStep(c, ti, tj)
                end

                local function copDrive(c, dt, now)
                    local dxp, dzp = player.x - c.x, player.z - c.z
                    local distP = math.sqrt(dxp * dxp + dzp * dzp)
                    -- توقع حركة اللاعب (يزيد بالمستويات)
                    local pa = player.ma or player.a
                    local px, pz = player.x, player.z
                    if cfg.pred > 0 and distP > 25 then
                        local lead = cfg.pred * math.min(1, distP / 80)
                        px = px - math.sin(pa) * player.v * lead
                        pz = pz - math.cos(pa) * player.v * lead
                    end
                    if c.flank ~= 0 and distP > 45 then
                        -- المحاصِر يستهدف التقاطع اللي قدامك عشان يقطع عليك
                        px = px - math.sin(pa) * player.v * 0.9
                        pz = pz - math.cos(pa) * player.v * 0.9
                    end
                    -- خط الرؤية (كل 0.15 ثانية)
                    c.losT = c.losT - dt
                    if c.losT <= 0 then
                        c.losT = 0.15
                        c.los = (distP < 75) and losClear(c.x, c.z, player.x, player.z, 3.0)
                    end

                    local tx, tz
                    local d1 = 1e9
                    local turning = false
                    if c.los then
                        -- شايفك: يلاحقك مباشرة
                        tx, tz = px, pz
                        if distP < 25 then tx, tz = player.x, player.z end
                        c.wi, c.w2i = nil, nil
                    else
                        -- ما يشوفك: يمشي على الشوارع باتجاهك
                        local ti, tj = nearIdx(px), nearIdx(pz)
                        if not c.wi then initPath(c, ti, tj) end
                        local w1x, w1z = roadC(c.wi), roadC(c.wj)
                        d1 = math.sqrt((w1x - c.x) ^ 2 + (w1z - c.z) ^ 2)
                        if d1 < 7 then
                            c.wi, c.wj, c.dx, c.dz = c.w2i, c.w2j, c.ndx, c.ndz
                            c.w2i, c.w2j, c.ndx, c.ndz = routeStep(c, ti, tj)
                            w1x, w1z = roadC(c.wi), roadC(c.wj)
                            d1 = math.sqrt((w1x - c.x) ^ 2 + (w1z - c.z) ^ 2)
                        end
                        turning = (c.dx ~= c.ndx or c.dz ~= c.ndz) and (c.dx ~= 0 or c.dz ~= 0)
                        local Lc = math.clamp(c.v * 0.35 + 10, 14, 30)
                        if d1 < Lc then
                            -- نقطة قدّام بعد المنعطف عشان يلف بنعومة بدون ما يلمس الزاوية
                            local rem = Lc - d1
                            tx = w1x + c.ndx * rem - c.ndz * c.lane
                            tz = w1z + c.ndz * rem + c.ndx * c.lane
                        else
                            tx = w1x - c.dz * c.lane
                            tz = w1z + c.dx * c.lane
                        end
                    end

                    local want = math.atan2(-(tx - c.x), -(tz - c.z))
                    local d = wrapA(want - c.a)
                    -- حماية إضافية: تفادي المباني القريبة
                    local L = math.clamp(c.v * 0.4 + 8, 10, 28)
                    local function probe(ang, dist)
                        return blockedAt(c.x - math.sin(ang) * dist, c.z - math.cos(ang) * dist, 2.0)
                    end
                    local steerAng = d
                    if probe(c.a, L) or probe(c.a, L * 0.5) then
                        local lb, rb = probe(c.a + 0.6, L), probe(c.a - 0.6, L)
                        if (not lb) and rb then steerAng = 1.2
                        elseif lb and (not rb) then steerAng = -1.2
                        elseif (not lb) and (not rb) then steerAng = (d >= 0) and 1.2 or -1.2
                        else steerAng = c.avoidSign * 1.2 end
                    end
                    local steer = math.clamp(steerAng * 1.7, -1, 1)
                    local target = cfg.speed * c.speedVar * (1 - math.min(0.5, math.abs(d) * 0.7))
                    if distP > 170 then target = target * 1.25 end
                    local boosting = false
                    if cfg.boost then
                        if now >= c.nextBoost then
                            c.boostUntil = now + 1.4
                            c.nextBoost = now + 6 + math.random() * 5
                        end
                        boosting = (now < c.boostUntil) and math.abs(d) < 0.25
                        if boosting then target = target + 16 end
                    end
                    -- يخفف قبل المنعطفات الحادة (حتى لو كان يستخدم بوست)
                    if turning and d1 < math.abs(c.v) * 0.9 + 10 then
                        target = math.min(target, cfg.corner)
                        boosting = false
                    end
                    -- إذا علق: يرجع للخلف شوي ثم يعيد حساب طريقه
                    if math.abs(c.v) < 6 then c.stuckT = c.stuckT + dt else c.stuckT = 0 end
                    if c.stuckT > 0.6 then
                        c.revUntil = now + 0.8
                        c.stuckT = 0
                        c.wi, c.w2i = nil, nil
                    end
                    if now < c.revUntil then
                        target = -16
                        steer = -steer
                    end
                    stepDrive(c, dt, steer, target, boosting, cfg.turn, false)
                end

                local function pushApart(a, b, minD, wa, wb)
                    local dx, dz = b.x - a.x, b.z - a.z
                    local dd = math.sqrt(dx * dx + dz * dz)
                    if dd < minD and dd > 0.001 then
                        local push = minD - dd
                        local ux, uz = dx / dd, dz / dd
                        a.x, a.z = a.x - ux * push * wa, a.z - uz * push * wa
                        b.x, b.z = b.x + ux * push * wb, b.z + uz * push * wb
                        return true
                    end
                    return false
                end

                local function startLevel(L)
                    level = L
                    if level > policeBest then policeBest = level end
                    cfg = levelCfg(level)
                    clearPolice()
                    player.x, player.z, player.a, player.ma, player.v, player.steer = roadC(6), roadC(6), 0, 0, 0, 0
                    timeLeft, bust, nitro, shake = cfg.time, 0, 100, 0
                    spawnT = cfg.reinf
                    for _ = 1, cfg.n0 do spawnCop(130, 260) end
                    camYaw = player.a
                    panel.Visible = false
                    levelLbl.Text = "المستوى " .. level
                    state = "count"
                    countStart = os.clock()
                    cdLbl.Text = "3"
                end

                local function finish(newState)
                    state = newState
                    cdLbl.Text = ""
                    pcall(function() if _G.SkyGameAudio then _G.SkyGameAudio.SetIntensity(0) end end)
                    task.delay(0.9, function()
                        if running and state == newState then showPanel(newState) end
                    end)
                end

                goBtn.Activated:Connect(function()
                    if state == "menu" then
                        startLevel(1)
                    elseif state == "won" then
                        startLevel(level + 1)
                    elseif state == "lost" then
                        startLevel(level)
                    end
                end)
                altBtn.Activated:Connect(function()
                    if state == "menu" then
                        startLevel(policeBest)
                    elseif state == "lost" then
                        startLevel(1)
                    end
                end)
                showPanel("menu")

                -- 🔁 اللعبة كل فريم
                local blinkPhase = -1
                local function step(dt)
                    dt = math.min(dt, 0.05)
                    local now = os.clock()
                    drifting = false
                    local camPos, camLook

                    if state == "play" then
                        local nOn = hold.n and nitro > 0
                        nitro = nOn and math.max(0, nitro - 28 * dt) or math.min(100, nitro + 9 * dt)
                        local dir = (hold.l and 1 or 0) - (hold.r and 1 or 0)
                        player.steer = player.steer + (dir - player.steer) * math.min(1, dt * 8)
                        local wantDrift = hold.d and player.v > 22
                        local cap = nOn and 98 or 66
                        if wantDrift then
                            cap = cap * 0.92
                        elseif math.abs(player.steer) > 0.45 and not nOn then
                            cap = 52 -- يخفف تلقائياً عند اللفّات الحادة (التفحيط يخليك تلف بسرعة أعلى)
                        end
                        stepDrive(player, dt, player.steer, cap, nOn, wantDrift and 2.2 or 1.5, wantDrift)
                        local slipNow = math.abs(wrapA(player.a - (player.ma or player.a)))
                        drifting = (wantDrift and slipNow > 0.18) and true or false
                        if drifting then nitro = math.min(100, nitro + 16 * dt) end
                        for _, c in ipairs(police) do copDrive(c, dt, now) end

                        -- تصادم السيارات
                        local contacts = 0
                        for i = 1, #police do
                            local c = police[i]
                            if pushApart(player, c, 3.2, 0.3, 0.7) then
                                player.v = player.v * (1 - 0.6 * dt)
                                shake = math.max(shake, 0.5)
                            end
                            local ddx, ddz = c.x - player.x, c.z - player.z
                            if ddx * ddx + ddz * ddz < 4.6 * 4.6 then contacts = contacts + 1 end
                            for j = i + 1, #police do pushApart(c, police[j], 3.2, 0.5, 0.5) end
                        end
                        local impact = hitBuildings(player, 1.6, dt)
                        if impact > 0.5 and player.v > 18 then shake = math.max(shake, impact * 0.8) end
                        for _, c in ipairs(police) do hitBuildings(c, 1.6, dt) end

                        -- مؤشر القبض
                        if contacts > 0 then
                            bust = bust + math.min(2, contacts) * dt / cfg.bust
                        else
                            bust = math.max(0, bust - 0.45 * dt)
                        end

                        -- تعزيزات الشرطة وإعادة تموضع البعيدين
                        spawnT = spawnT - dt
                        if spawnT <= 0 then
                            spawnT = cfg.reinf
                            if #police < cfg.nMax then spawnCop(150, 260) end
                        end
                        for _, c in ipairs(police) do
                            local ddx, ddz = c.x - player.x, c.z - player.z
                            if ddx * ddx + ddz * ddz > 300 * 300 then placeCop(c, 150, 240) end
                        end

                        timeLeft = timeLeft - dt
                        if bust >= 1 then
                            finish("lost")
                        elseif timeLeft <= 0 then
                            timeLeft = 0
                            finish("won")
                        end
                        pcall(function()
                            if _G.SkyGameAudio then _G.SkyGameAudio.SetIntensity(math.floor(player.v / 12) + level) end
                        end)
                    elseif state == "count" then
                        local left = 3 - (now - countStart)
                        if left <= 0 then
                            state = "play"
                            cdLbl.Text = "🏁 انطلق!"
                            task.delay(1, function()
                                if running and cdLbl.Text == "🏁 انطلق!" then cdLbl.Text = "" end
                            end)
                            pcall(function() if _G.SkyGameAudio then _G.SkyGameAudio.Begin("race", "action") end end)
                        else
                            cdLbl.Text = tostring(math.ceil(left))
                        end
                    elseif state == "won" or state == "lost" then
                        player.v = math.max(0, player.v - 30 * dt)
                        player.x = player.x - math.sin(player.a) * player.v * dt
                        player.z = player.z - math.cos(player.a) * player.v * dt
                        for _, c in ipairs(police) do
                            c.v = math.max(0, c.v - 30 * dt)
                            c.x = c.x - math.sin(c.a) * c.v * dt
                            c.z = c.z - math.cos(c.a) * c.v * dt
                        end
                        hitBuildings(player, 1.6, dt)
                    end

                    -- 🎥 الكاميرا
                    if state == "menu" then
                        orbit = orbit + dt * 0.12
                        camPos = Vector3.new(math.cos(orbit) * 300, 150, math.sin(orbit) * 300)
                        camLook = Vector3.new(0, 0, 0)
                        cam3d.FieldOfView = 62
                    else
                        camYaw = camYaw + wrapA(player.a - camYaw) * math.min(1, dt * 5)
                        local fx, fz = -math.sin(camYaw), -math.cos(camYaw)
                        local sh = 0
                        if shake > 0 then
                            sh = (math.random() - 0.5) * shake * 1.2
                            shake = math.max(0, shake - dt * 2)
                        end
                        camPos = Vector3.new(player.x - fx * 10 + sh, 4.8, player.z - fz * 10 + sh)
                        camLook = Vector3.new(player.x + fx * 14, 1.2, player.z + fz * 14)
                        cam3d.FieldOfView = 70 + math.clamp((player.v - 30) * 0.4, 0, 26)
                    end
                    cam3d.CFrame = CFrame.lookAt(camPos, camLook)

                    -- 🚗 تحديث المجسمات
                    playerCar:PivotTo(CFrame.new(player.x, 0.65, player.z) * CFrame.Angles(0, player.a, -player.steer * player.v * 0.0005))
                    local ph = math.floor(now * 5) % 2
                    for _, c in ipairs(police) do
                        c.m:PivotTo(CFrame.new(c.x, 0.65, c.z) * CFrame.Angles(0, c.a, 0))
                        if ph ~= blinkPhase and #c.lights >= 2 then
                            c.lights[1].Color = (ph == 0) and COP_RED or COP_BLUE
                            c.lights[2].Color = (ph == 0) and COP_BLUE or COP_RED
                        end
                        local mx, mz = mmPos(c.x, c.z)
                        c.dot.Position = UDim2.new(0, mx - 3, 0, mz - 3)
                    end
                    blinkPhase = ph
                    local mx, mz = mmPos(player.x, player.z)
                    meDot.Position = UDim2.new(0, mx - 4, 0, mz - 4)

                    -- 📊 الواجهة
                    local boostingNow = (state == "play") and hold.n and nitro > 0
                    boostTag.Visible = boostingNow
                    if boostEmitter then boostEmitter.Enabled = boostingNow end
                    if smokeEmitter then smokeEmitter.Enabled = drifting end
                    driftTag.Visible = drifting
                    spLbl.Text = math.floor(player.v * 2.2) .. " كم/س"
                    spLbl.TextColor3 = boostingNow and Color3.fromRGB(90, 220, 255) or Color3.new(1, 1, 1)
                    nFill.Size = UDim2.new(nitro / 100, 0, 1, 0)
                    bustFill.Size = UDim2.new(math.clamp(bust, 0, 1), 0, 1, 0)
                    if state == "menu" then
                        timeLbl.Text = ""
                        policeLbl.Text = ""
                    else
                        timeLbl.Text = "⏱ " .. math.ceil(timeLeft)
                        timeLbl.TextColor3 = (timeLeft <= 8) and Color3.fromRGB(255, 110, 110) or Color3.new(1, 1, 1)
                        policeLbl.Text = "🚓 الشرطة: " .. #police
                    end
                end

                local errored = false
                connections[#connections + 1] = RunService.RenderStepped:Connect(function(dt)
                    if not running then return end
                    local ok, err = pcall(step, dt)
                    if not ok and not errored then
                        errored = true
                        warn("[Sky] Police step: " .. tostring(err))
                    end
                end)
            end)

            if not okRun then
                warn("[Sky] Police error: " .. tostring(errRun))
                local msg = Instance.new("TextLabel")
                msg.BackgroundTransparency = 1
                msg.Size = UDim2.new(1, 0, 0, 40)
                msg.Position = UDim2.new(0, 0, 0.5, -20)
                msg.Font = Enum.Font.Arcade
                msg.TextSize = 18
                msg.TextColor3 = Color3.fromRGB(255, 120, 120)
                msg.Text = "⚠️ تعذر تشغيل اللعبة، اضغط خروج"
                msg.ZIndex = Z + 5
                msg.Parent = overlay
            end
        end

