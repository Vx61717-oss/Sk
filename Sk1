            -- انتظر تحميل الصوت حتى نعرف مدته الفعلية، ثم اجعل اختفاء
            -- الصورة وانخفاض صوتها يبدأان معًا قرب نهاية الصوت.
            task.spawn(function()
                local loaded = mathWrongSound.IsLoaded
                if not loaded then
                    pcall(function()
                        mathWrongSound.Loaded:Wait()
                    end)
                end

                if not mathErrorImage.Parent then return end

                local soundLength = mathWrongSound.TimeLength
                if not soundLength or soundLength <= 0 then
                    soundLength = 2.5 -- احتياط إذا لم تتوفر مدة الصوت
                end

                local elapsed = os.clock() - startedAt
                local waitBeforeFade = math.max(0, soundLength - elapsed - fadeDuration)
                task.wait(waitBeforeFade)

                if not mathErrorImage.Parent then return end

                local fadeImage = TweenService:Create(
                    mathErrorImage,
                    TweenInfo.new(fadeDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut),
                    {ImageTransparency = 1, Size = UDim2.new(0, 228, 0, 228)}
                )
                local fadeSound = TweenService:Create(
                    mathWrongSound,
                    TweenInfo.new(fadeDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut),
                    {Volume = 0}
                )

                mathErrorTween = fadeImage
                fadeImage:Play()
                fadeSound:Play()
                fadeImage.Completed:Wait()

                if mathErrorImage.Parent and mathErrorTween == fadeImage then
                    mathErrorImage.Visible = false
                end
                pcall(function()
                    mathWrongSound:Stop()
                    mathWrongSound.Volume = 0.75
                end)
