                    for i = 1, #a.sounds do
                        local w = weights[i] or 10
                        if i == a.last then w = 0 elseif i == a.prev then w = w * 0.4 end
                        if w > 0 then pool[#pool + 1] = {i, w}; total = total + w end
                    end
                    if total <= 0 then a.gap = a.pickGap() return end
                    local roll, chosenIndex = math.random() * total, pool[#pool][1]
                    for _, e in ipairs(pool) do
                        roll = roll - e[2]
                        if roll <= 0 then chosenIndex = e[1] break end
                    end

                    local chosen = a.sounds[chosenIndex]
                    if not chosen then a.gap = a.pickGap() return end
                    a.prev, a.last = a.last, chosenIndex
