                    end
                    local function chair(x, z, rot, col)
                        local b = freeBase(x, z, rot)
                        box(b, 0, 1.7, 0, 2.2, 0.4, 2.2, col, Enum.Material.Wood)
                        for _, ox in ipairs({-0.9, 0.9}) do
                            for _, oz in ipairs({-0.9, 0.9}) do box(b, ox, 0, oz, 0.3, 1.7, 0.3, col, Enum.Material.Wood) end
                        end
                        box(b, 0, 2.1, 1.0, 2.2, 2.4, 0.3, col, Enum.Material.Wood)
