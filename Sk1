                local function hitBuildings(c, r, dt)
                    local ci = math.floor((c.x + HALF) / PERIOD)
                    local cj = math.floor((c.z + HALF) / PERIOD)
                    local worst = 0
                    for i = ci - 1, ci + 1 do
                        local row = blocks[i]
                        if row then
                            for j = cj - 1, cj + 1 do
                                local lst = row[j]
                                if lst then
                                    for _, b in ipairs(lst) do
                                        local nx = math.clamp(c.x, b[1], b[2])
                                        local nz = math.clamp(c.z, b[3], b[4])
                                        local dx, dz = c.x - nx, c.z - nz
                                        local d2 = dx * dx + dz * dz
                                        if d2 < r * r then
                                            local dot = 1
                                            if d2 > 1e-6 then
                                                local d = math.sqrt(d2)
                                                local ux, uz = dx / d, dz / d
                                                c.x = nx + ux * r
                                                c.z = nz + uz * r
                                                local ha = c.ma or c.a
                                                local fx, fz = -math.sin(ha), -math.cos(ha)
                                                dot = math.clamp(-(fx * ux + fz * uz), 0, 1)
                                            else
                                                local l, rr, t, bt = c.x - b[1], b[2] - c.x, c.z - b[3], b[4] - c.z
                                                local m = math.min(l, rr, t, bt)
                                                if m == l then c.x = b[1] - r
                                                elseif m == rr then c.x = b[2] + r
                                                elseif m == t then c.z = b[3] - r
                                                else c.z = b[4] + r end
                                            end
                                            c.v = c.v * math.max(0, 1 - (0.8 + 8 * dot) * dt)
                                            if dot > worst then worst = dot end
                                        end
                                    end
                                end
                            end
                        end
                    end
                    -- حدود الماب
                    local lim = HALF - 3
                    if c.x < -lim or c.x > lim or c.z < -lim or c.z > lim then
                        c.x = math.clamp(c.x, -lim, lim)
                        c.z = math.clamp(c.z, -lim, lim)
                        c.v = c.v * math.max(0, 1 - 6 * dt)
                        worst = math.max(worst, 0.8)
                    end
                    return worst
                end
