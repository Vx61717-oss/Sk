                            head = head + 1
                            for _, d in ipairs(DIRS) do
                                local nx, ny = c[1] + d[1], c[2] + d[2]
                                if nx >= 2 and nx <= COLS - 1 and ny >= 2 and ny <= ROWS - 1 and prev[key(nx, ny)] == nil then
                                    if not g[ny][nx] then
                                        if comp[ny][nx] ~= small then
                                            foundCell = c
                                            break
                                        end
                                    elseif not prot[key(nx, ny)] then
                                        prev[key(nx, ny)] = c
                                        q[#q + 1] = {nx, ny}
                                    end
                                end
                            end
                        end
                        if foundCell then
                            local cur = foundCell
                            while cur do
                                g[cur[2]][cur[1]] = false
                                cur = prev[key(cur[1], cur[2])]
                            end
                        else
                            -- جيب معزول ما نقدر نوصله: نسدّه بجدار
                            for y = 2, ROWS - 1 do
                                for x = 2, COLS - 1 do
                                    if comp[y][x] == small then g[y][x] = true end
                                end
                            end
                        end
                    end
                end

                local wall0, wall1, void1, prot0, prot1, rampSet
                local Ex, Ey, Cx, Cy, RDX, RDY, RSX, RSY
                local startX, startY, startDist, allNodes
                local exitX, exitY, exitWall, maxD
                local keyCells, mSpawn, lampCells
                local H = {} -- معلومات القصر: الغرف، الأبواب، الساعات، الدولاب، البطاريات

                local function open3(f, x, y)
                    if x < 1 or x > COLS or y < 1 or y > ROWS then return false end
                    if f == 0 then return not wall0[y][x] end
                    return not wall1[y][x]
                end
                -- جيران خانة بالدور (يشمل الربط بين الدورين عن طريق السلم)
                local function nbrs3(f, x, y)
                    local r = {}
                    for _, d in ipairs(DIRS) do
                        local nx, ny = x + d[1], y + d[2]
                        if open3(f, nx, ny) then r[#r + 1] = {f, nx, ny} end
                    end
                    if f == 0 and x == Cx and y == Cy then
                        r[#r + 1] = {1, Ex, Ey}
                    elseif f == 1 and x == Ex and y == Ey then
                        r[#r + 1] = {0, Cx, Cy}
                    end
                    return r
                end
                local function bfs3(sf, sx, sy)
                    local dist = {[0] = {}, [1] = {}}
                    for y = 1, ROWS do
                        dist[0][y] = {}
                        dist[1][y] = {}
                    end
                    dist[sf][sy][sx] = 0
                    local q, head = {{sf, sx, sy}}, 1
                    while head <= #q do
                        local c = q[head]
                        head = head + 1
                        local cd = dist[c[1]][c[3]][c[2]]
                        for _, n in ipairs(nbrs3(c[1], c[2], c[3])) do
                            if dist[n[1]][n[3]][n[2]] == nil then
                                dist[n[1]][n[3]][n[2]] = cd + 1
                                q[#q + 1] = n
                            end
                        end
                    end
                    return dist
                end

                -- أماكن الأثاث على جدران الغرفة (بعيد عن الأبواب)
                local function roomSlots(f, r)
                    local gg = (f == 0) and wall0 or wall1
                    local list = {}
                    for y = r.y0, r.y1 do
                        for x = r.x0, r.x1 do
                            if not H.noF[f][key(x, y)] and not rampSet[key(x, y)] then
                                for _, d in ipairs(DIRS) do
                                    local wx, wy = x + d[1], y + d[2]
                                    if gg[wy] and gg[wy][wx] and not (f == 1 and void1[key(wx, wy)]) then
                                        list[#list + 1] = {x = x, y = y, nx = -d[1], ny = -d[2]}
                                    end
                                end
                            end
                        end
                    end
                    return list
                end

                local function tryGen()
                    local i0, i1
                    wall0, i0 = genPalace(0)
                    wall1, i1 = genPalace(1)
                    H.info = {[0] = i0, [1] = i1}
                    H.noF = {[0] = {}, [1] = {}}
                    for f = 0, 1 do
                        for _, dc in ipairs(H.info[f].doors) do
                            for dy = -2, 2 do
                                for dx = -2, 2 do
                                    if math.abs(dx) + math.abs(dy) <= 2 then H.noF[f][key(dc[1] + dx, dc[2] + dy)] = true end
                                end
                            end
                        end
                    end
                    void1, prot0, prot1, rampSet = {}, {}, {}, {}
                    -- 🪜 السلم: 3 خانات صعود (a,b,c) من خانة الدخول s0، وفوق ينتهي عند الخانة E بالدور العلوي
                    do
                                                local best = {(COLS + 1) // 2, ROWS - 5, {0, -1}} -- الدرج قدامك من اللوبي، يطلع للشمال
                    local ox, oy, d = best[1], best[2], best[3]
                        local qx, qy = -d[2], d[1]
                        local function P(k, r) return ox + d[1] * k + qx * r, oy + d[2] * k + qy * r end
                        wall0[oy][ox] = false
                        for k = 1, 3 do
                            for r = -1, 1, 2 do
                                local x, y = P(k, r)
                                wall0[y][x] = true
                                prot0[key(x, y)] = true
                                wall1[y][x] = true
                                prot1[key(x, y)] = true
                            end
                            local x, y = P(k, 0)
                            wall0[y][x] = false
                            wall1[y][x] = true
                            void1[key(x, y)] = true
                            prot1[key(x, y)] = true
                            rampSet[key(x, y)] = true
                        end
                        Ex, Ey = P(4, 0)
                        Cx, Cy = P(3, 0)
                        wall0[Ey][Ex] = true
                        prot0[key(Ex, Ey)] = true
                        wall1[Ey][Ex] = false
                        wall1[oy][ox] = true
                        prot1[key(ox, oy)] = true
                        RDX, RDY = d[1], d[2]
                        local ax, ay = P(1, 0)
                        RSX, RSY = (ax - 0.5) * C - d[1] * C / 2, (ay - 0.5) * C - d[2] * C / 2
                    end
                    connectFix(wall0, prot0)
                    connectFix(wall1, prot1)

                    -- 📍 مكان البداية (زاوية الدور الأرضي)، المخرج (الباب الخارجي الأبعد)، المفاتيح، الوحش
                    startX, startY = (COLS + 1) // 2, ROWS - 2 -- تبدأ باللوبي، الباب وراك والدرج قدامك
                    startDist = bfs3(0, startX, startY)
                    allNodes = {}
                    for f = 0, 1 do
                        for y = 2, ROWS - 1 do
                            for x = 2, COLS - 1 do
                                if startDist[f][y][x] then allNodes[#allNodes + 1] = {f, x, y} end
                            end
                        end
                    end


                    -- كل الخانات المفتوحة لازم توصل من البداية (بالدورين)
                    do
                        local openCount = 0
                        for f = 0, 1 do
                            for y = 2, ROWS - 1 do
                                for x = 2, COLS - 1 do
                                    if open3(f, x, y) then openCount = openCount + 1 end
                                end
                            end
                        end
                        if openCount ~= #allNodes then return false end
                        if not startDist[1][Ey][Ex] then return false end
                    end

                    exitX, exitY, exitWall = (COLS + 1) // 2, ROWS - 1, {0, 1} -- باب القصر الخارجي (وراك)
                    maxD = startDist[0][exitY][exitX] or -1
                    if maxD < 0 then return false end

                    keyCells = {}
                    do
                        local byFloor = {[0] = {}, [1] = {}}
                        for _, n in ipairs(allNodes) do
                            local f, x, y = n[1], n[2], n[3]
                            local d = startDist[f][y][x]
                            if d >= 9 and not rampSet[key(x, y)] and not (f == 0 and x == exitX and y == exitY) then
                                table.insert(byFloor[f], n)
                            end
                        end
                        if #byFloor[0] == 0 or #byFloor[1] == 0 then return false end
                        local pattern = (math.random() < 0.5) and {0, 1} or {1, 0}
                        for _, f in ipairs(pattern) do
                            local list = byFloor[f]
                            local picked
                            for _ = 1, 300 do
                                local cand = list[math.random(#list)]
                                local ok = true
                                for _, k in ipairs(keyCells) do
                                    local dd = math.sqrt((k[1] - cand[2]) ^ 2 + (k[2] - cand[3]) ^ 2)
                                    if (k[3] == f and dd < 7) or dd < 3 then ok = false break end
                                end
                                if ok then picked = cand break end
                            end
                            picked = picked or list[math.random(#list)]
                            table.insert(keyCells, {picked[2], picked[3], f})
                        end
                    end

                    mSpawn = nil
                    do
                        local far = {}
                        for _, n in ipairs(allNodes) do
                            if startDist[n[1]][n[3]][n[2]] >= 16 and not rampSet[key(n[2], n[3])] then far[#far + 1] = n end
                        end
                        if #far == 0 then
                            for _, n in ipairs(allNodes) do
                                if startDist[n[1]][n[3]][n[2]] >= 8 then far[#far + 1] = n end
                            end
                        end
                        local n = far[math.random(#far)] or allNodes[#allNodes]
                        mSpawn = {n[2], n[3], n[1]}
                    end

                    -- 💡 أماكن اللمبات (حوالي 12 لكل دور)
                    lampCells = {}
                    for f = 0, 1 do
                        local cells = {}
                        for y = 2, ROWS - 1 do
                            for x = 2, COLS - 1 do
                                if startDist[f][y][x] and not rampSet[key(x, y)] and not (f == 0 and x == exitX and y == exitY) then
                                    cells[#cells + 1] = {x, y}
                                end
                            end
                        end
                        shuffle(cells)
                        if f == 0 then
                            for i, c in ipairs(cells) do
                                local d = startDist[0][c[2]][c[1]]
                                if d >= 3 and d <= 6 then
                                    table.insert(cells, 1, table.remove(cells, i))
                                    break
                                end
                            end
                        end
                        local placed = {}
                        for _, c in ipairs(cells) do
                            if #placed >= 16 then break end
                            local okSp = true
                            for _, l in ipairs(placed) do
                                if (l[1] - c[1]) ^ 2 + (l[2] - c[2]) ^ 2 < 16 then okSp = false break end
                            end
                            if okSp then
                                placed[#placed + 1] = c
                                lampCells[#lampCells + 1] = {c[1], c[2], f}
                            end
                        end
                    end


                    -- 🕰️ أربع ساعات (3 و 6 و 4 و 9) بغرف مختلفة + دولاب اللغز + بطاريات للكشاف
                    do
                        local T = {3, 6, 4, 9}
                        H.code = table.concat(T)
                        local cand = {}
                        for f = 0, 1 do
                            for _, r in ipairs(H.info[f].rooms) do
                                if r.name ~= "lobby" and r.name ~= "dining" and r.name ~= "corridor" then
                                    cand[#cand + 1] = {f = f, r = r}
                                end
                            end
                        end
                        shuffle(cand)
                        H.clocks = {}
                        for _, c in ipairs(cand) do
                            if #H.clocks >= 4 then break end
                            local sl = roomSlots(c.f, c.r)
                            if #sl > 0 then
                                local s = sl[math.random(#sl)]
                                local n = #H.clocks + 1
                                H.noF[c.f][key(s.x, s.y)] = true
                                H.clocks[n] = {f = c.f, x = s.x, y = s.y, nx = s.nx, ny = s.ny, n = n, hour = T[n], room = c.r.name}
                            end
                        end
                        if #H.clocks < 4 then return false end
                        H.cab = {f = 0, x = (COLS + 1) // 2, y = 4, nx = 0, ny = 1}
                        for dx = -1, 1 do H.noF[0][key(H.cab.x + dx, 4)] = true end
                        -- 🎨 لوحة لغز الألوان: على جدار غرفة (يفضّل غرفة ما فيها ساعة)
                        do
                            local clockRooms = {}
                            for _, ck in ipairs(H.clocks) do clockRooms[ck.room] = true end
                            local pref, rest = {}, {}
                            for _, c in ipairs(cand) do
                                if clockRooms[c.r.name] then rest[#rest + 1] = c else pref[#pref + 1] = c end
                            end
                            for _, c in ipairs(rest) do pref[#pref + 1] = c end
                            H.col = nil
                            -- 📌 مكان ثابت: نفس جدار الدولاب (القاعة الخلفية) بس على جنب، 4 خانات عنه
                            for _, off in ipairs({4, -4, 5, -5, 3, -3}) do
                                local fx, fy = H.cab.x + off, H.cab.y
                                if wall0[fy - 1] and wall0[fy - 1][fx] and wall0[fy] and wall0[fy][fx] == false and not rampSet[key(fx, fy)] and not H.noF[0][key(fx, fy)] then
                                    H.noF[0][key(fx, fy)] = true
                                    H.col = {f = 0, x = fx, y = fy, nx = H.cab.nx, ny = H.cab.ny}
                                    break
                                end
                            end
                            for _, c in ipairs(H.col and {} or pref) do -- (لو ما لقى مكان ثابت يرجع للعشوائي)
                                local sl = roomSlots(c.f, c.r)
                                if #sl > 0 then
                                    local s = sl[math.random(#sl)]
                                    H.noF[c.f][key(s.x, s.y)] = true
                                    H.col = {f = c.f, x = s.x, y = s.y, nx = s.nx, ny = s.ny}
                                    break
                                end
                            end
                            if not H.col then return false end
                        end
                        -- 🚪 دواليب الاختباء: دولاب بكل غرفة على الجدار (القاعات الكبيرة والممر: دولابين)
                        H.hides = {}
                        for f = 0, 1 do
                            for _, r in ipairs(H.info[f].rooms) do
                                local want = (r.name == "lobby" or r.name == "dining" or r.name == "corridor") and 2 or 1
                                local got = {}
                                for _ = 1, want do
                                    local sl = roomSlots(f, r)
                                    shuffle(sl)
                                    for _, s in ipairs(sl) do
                                        local farOK = true
                                        for _, g in ipairs(got) do
                                            if (g.x - s.x) ^ 2 + (g.y - s.y) ^ 2 < 25 then farOK = false break end
                                        end
                                        if farOK then
                                            H.noF[f][key(s.x, s.y)] = true
                                            local hh = {f = f, x = s.x, y = s.y, nx = s.nx, ny = s.ny, room = r.name}
                                            got[#got + 1] = hh
                                            H.hides[#H.hides + 1] = hh
                                            break
                                        end
                                    end
                                end
                            end
                        end
                        H.bats = {}
                        local pool = {}
                        for _, n in ipairs(allNodes) do
                            local f, x, y = n[1], n[2], n[3]
                            if startDist[f][y][x] >= 4 and not rampSet[key(x, y)] and not H.noF[f][key(x, y)] then pool[#pool + 1] = n end
                        end
                        shuffle(pool)
                        local cnt = {[0] = 0, [1] = 0}
                        for _, n in ipairs(pool) do
                            if #H.bats >= 8 then break end
                            local f = n[1]
                            if cnt[f] < 4 then
                                local ok = true
                                for _, b in ipairs(H.bats) do
                                    if b[3] == f and (b[1] - n[2]) ^ 2 + (b[2] - n[3]) ^ 2 < 36 then ok = false break end
                                end
                                for _, k in ipairs(keyCells) do
                                    if k[3] == f and k[1] == n[2] and k[2] == n[3] then ok = false end
                                end
                                if ok then
                                    H.bats[#H.bats + 1] = {n[2], n[3], f}
                                    cnt[f] = cnt[f] + 1
                                end
                            end
                        end
                    end
                    return true
                end
                do
                    local okGen = false
                    for _ = 1, 80 do
                        if tryGen() then okGen = true break end
                    end
                    if not okGen then error("تعذر توليد القصر") end
                end

                -- 🎮 حالة اللاعب والوحش
                local pf = 0 -- الدور اللي واقف فيه (0 أرضي / 1 علوي)
                local px, py = (startX - 0.5) * C, (startY - 0.5) * C
                local yaw, pitch = 0, 0
                do
                    local bestN = -1
                    for _, d in ipairs(DIRS) do
                        local n, x, y = 0, startX, startY
                        while open3(0, x + d[1], y + d[2]) and n < 14 do
                            x, y, n = x + d[1], y + d[2], n + 1
                        end
                        if n > bestN then
                            bestN = n
                            yaw = math.atan2(-d[1], -d[2])
                        end
                    end
                end
                yaw = 0 -- تطل على الدرج (الباب وراك)
                local fwdX, fwdZ = -math.sin(yaw), -math.cos(yaw)
                local mf = mSpawn[3]
                local mx, my = (mSpawn[1] - 0.5) * C, (mSpawn[2] - 0.5) * C
                local lamps = {}
                local statics = {}

                -- ارتفاع الأرض تحت نقطة (السلم يرتفع تدريجياً)
                local function elevAt(f, x, y)
                    if f == 1 then return FH end
                    local cx, cy = math.floor(x / C) + 1, math.floor(y / C) + 1
                    if rampSet[key(cx, cy)] then
                        local proj = (x - RSX) * RDX + (y - RSY) * RDY
                        local t = proj / (3 * C)
                        if t < 0 then t = 0 elseif t > 1 then t = 1 end
                        return FH * t
                    end
                    return 0
                end
                local pElev, viewElev = 0, 0
                local mElev = elevAt(mf, mx, my)

                -- 🧊 عرض 3D (ViewportFrame)
                local view3d = Instance.new("ViewportFrame")
                view3d.Name = "Horror3DView"
                view3d.Size = UDim2.new(1, 0, 1, 0)
                view3d.BackgroundColor3 = BLACK
                view3d.BorderSizePixel = 0
                view3d.Active = false
                view3d.ZIndex = Z + 1
                view3d.Ambient = Color3.fromRGB(150, 150, 162)
                view3d.LightColor = Color3.fromRGB(150, 140, 130)
                view3d.LightDirection = Vector3.new(-0.4, -1, -0.3)
                view3d.Parent = overlay

                local cam3d = Instance.new("Camera")
                cam3d.FieldOfView = 78
                cam3d.Parent = view3d
                view3d.CurrentCamera = cam3d

                local scene = Instance.new("Folder")
                scene.Name = "Scene"
                scene.Parent = view3d

                local FLAT = CFrame.Angles(0, 0, math.pi / 2) -- يوقّف الأسطوانة بشكل مسطّح

                -- 🧱 نظام القطع: كل قطعة تتسجل بخانة (bucket) ولا تظهر إلا القريبة منك (عشان البيت الكبير ما يثقّل)
                local buckets = {}
                local curFloor, curBase = 0, 0
                local function bucketOf(x, z, f)
                    local cx, cy = math.floor(x / C) + 1, math.floor(z / C) + 1
                    if cx < 1 then cx = 1 elseif cx > COLS then cx = COLS end
                    if cy < 1 then cy = 1 elseif cy > ROWS then cy = ROWS end
                    local bk = (f * 100 + cy) * 1000 + cx
                    local b = buckets[bk]
                    if not b then
                        b = {parts = {}, statics = {}, f = f, cx = cx, cy = cy, vis = false}
                        buckets[bk] = b
                    end
                    return b
                end

                local function mkPart(parent, size, color, cf, shape, material)
                    local p = Instance.new("Part")
                    p.Anchored = true
                    p.CanCollide = false
                    p.CanQuery = false
                    p.CanTouch = false
                    p.CastShadow = false
                    p.Size = size
                    p.Color = color
                    p.Material = material or Enum.Material.SmoothPlastic
                    if shape then p.Shape = shape end
                    p.CFrame = CFrame.new(0, curBase, 0) * (cf or CFrame.new())
                    p.Parent = parent
                    return p
                end
                -- يسجّل القطعة بخانتها (تختفي لين تقرب منها)
                local function reg(p, x, z)
                    local b = bucketOf(x, z, curFloor)
                    b.parts[#b.parts + 1] = p
                    p.Parent = nil
                    return b
                end
                local function addStatic(p, base, ax, az)
                    local pos = p.Position
                    local b = reg(p, pos.X, pos.Z)
                    b.statics[#b.statics + 1] = {p = p, base = base or p.Color, x = ax or pos.X, z = az or pos.Z, last = -1, f = curFloor}
                    return p
                end

                -- 💡 نظام الإضاءة: الكشاف + اللمبات + نور الوحش (كل شي يغمق حسب البعد)
                local FLASH_R = 7.5 * C
                local AURA_R = 3.2 * C
                local LAMP_R = 3.4 * C
                local MON_R = 3.4 * C
                local nearLamps = {}
                -- 🔦 حالة الكشاف (I = شدة النور الحالية 0..1)
                local FL = {on = true, bat = 100, I = 1, flickT = 0, flickOn = true, dead = false}
                local function brightAt(x, z, f, src)
                    local b = 0.025
                    if math.abs(f * FH - pElev) < FH * 0.9 then
                        local dx, dz = x - px, z - py
                        local d = math.sqrt(dx * dx + dz * dz)
                        local auraR = AURA_R * (0.5 + 0.5 * FL.I)
                        if d < auraR then
                            local a = 1 - d / auraR
                            b = math.max(b, (0.12 + 0.43 * FL.I) * a * a)
                        end
                        if d < FLASH_R and FL.I > 0.01 then
                            local dot = 1
                            if d > 0.5 then dot = (dx * fwdX + dz * fwdZ) / d end
                            local fc = (dot - 0.72) / 0.22
                            if fc > 0 then
                                if fc > 1 then fc = 1 end
                                local r = 1 - d / FLASH_R
                                b = math.max(b, (r ^ 1.1) * fc * FL.I)
                            end
                        end
                    end
                    local list = src or nearLamps
                    for i = 1, #list do
                        local l = list[i]
                        if l.on and l.f == f then
                            local ldx, ldz = x - l.x, z - l.z
                            local ld = math.sqrt(ldx * ldx + ldz * ldz)
                            if ld < LAMP_R then
                                local a = 1 - ld / LAMP_R
                                b = math.max(b, 0.95 * (a ^ 1.3))
                            end
                        end
                    end
                    -- 👹 الوحش له نور خاص فيه (يبين بالليل وينوّر اللي حوله)
                    if f == mf then
                        local mdx, mdz = x - mx, z - my
                        local md2 = math.sqrt(mdx * mdx + mdz * mdz)
                        if md2 < MON_R then
                            local a = 1 - md2 / MON_R
                            b = math.max(b, 0.55 * (a ^ 1.4))
                        end
                    end
                    if b > 1 then b = 1 end
                    return b
                end

                local visList = {}
                local vcx, vcy, vshow0, vshow1
                local function relightBucket(b)
                    local st = b.statics
                    for i = 1, #st do
                        local s = st[i]
                        local br = brightAt(s.x, s.z, s.f)
                        if math.abs(br - s.last) > 0.012 then
                            s.last = br
                            s.p.Color = s.base:Lerp(BLACK, 1 - br)
                        end
                    end
                end
                local function refreshNearLamps()
                    nearLamps = {}
                    local lim = ((VR + 3.5) * C) ^ 2
                    for i = 1, #lamps do
                        local l = lamps[i]
                        if l.on then
                            local dx, dz = l.x - px, l.z - py
                            if dx * dx + dz * dz < lim then nearLamps[#nearLamps + 1] = l end
                        end
                    end
                end
                local function relight()
                    refreshNearLamps()
                    for i = 1, #visList do relightBucket(visList[i]) end
                end
                local function updateVis(force)
                    local pcx, pcy = math.floor(px / C) + 1, math.floor(py / C) + 1
                    local s0 = math.abs(0 - pElev) < FH * 0.9
                    local s1 = math.abs(FH - pElev) < FH * 0.9
                    if not force and pcx == vcx and pcy == vcy and s0 == vshow0 and s1 == vshow1 then return end
                    vcx, vcy, vshow0, vshow1 = pcx, pcy, s0, s1
                    visList = {}
                    refreshNearLamps()
                    for _, b in pairs(buckets) do
                        local want = math.abs(b.cx - pcx) <= VR and math.abs(b.cy - pcy) <= VR
                            and ((b.f == 0 and s0) or (b.f == 1 and s1))
                        if want then visList[#visList + 1] = b end
                        if want ~= b.vis then
                            b.vis = want
                            if want then
                                relightBucket(b)
                                for i = 1, #b.parts do b.parts[i].Parent = scene end
                            else
                                for i = 1, #b.parts do b.parts[i].Parent = nil end
                            end
                        end
                    end
                end

                -- 🧱 الأرضية والسقف والجدران (الدورين)
                do
                local rgb = Color3.fromRGB
                -- 🎨 ستايل كل غرفة (ألوان الأرضية والجدار والسقف)
                local ST, STDEF = {}, nil
                do
                    local M = Enum.Material
                    local function S(n, f1, f2, wall, ceil, mat) ST[n] = {f1 = f1, f2 = f2, wall = wall, ceil = ceil, mat = mat} end
                    S("lobby", rgb(190, 184, 172), rgb(110, 104, 98), rgb(150, 128, 98), rgb(70, 60, 56), M.Marble)
                    S("dining", rgb(104, 64, 44), rgb(84, 50, 36), rgb(120, 40, 48), rgb(60, 40, 38), M.WoodPlanks)
                    S("flankW", rgb(66, 82, 62), rgb(52, 66, 50), rgb(88, 66, 46), rgb(54, 42, 34), M.WoodPlanks)   -- مكتبة
                    S("flankE", rgb(206, 206, 200), rgb(80, 84, 90), rgb(226, 220, 196), rgb(180, 180, 176), M.Slate)  -- مطبخ
                    S("rearW", rgb(112, 84, 120), rgb(96, 70, 106), rgb(156, 124, 164), rgb(96, 80, 100), M.Fabric)   -- غرفة نوم
                    S("rearE", rgb(196, 214, 222), rgb(150, 176, 190), rgb(190, 214, 226), rgb(210, 220, 226), M.Slate)  -- حمام
                    S("frontUpW", rgb(170, 210, 190), rgb(130, 180, 160), rgb(160, 206, 186), rgb(206, 226, 216), M.Slate) -- حمام 2
                    S("frontUpE", rgb(236, 190, 90), rgb(120, 180, 224), rgb(250, 214, 140), rgb(250, 238, 200), M.SmoothPlastic) -- اطفال
                    S("frontLoW", rgb(78, 74, 70), rgb(64, 60, 58), rgb(96, 90, 82), rgb(52, 48, 46), M.Concrete)      -- مخزن
                    S("frontLoE", rgb(72, 94, 140), rgb(60, 80, 120), rgb(110, 138, 190), rgb(180, 196, 220), M.Fabric) -- ضيوف
                    S("corridor", rgb(128, 40, 46), rgb(98, 30, 36), rgb(120, 96, 70), rgb(60, 48, 42), M.Fabric)
                    S("nwW", rgb(94, 40, 52), rgb(74, 30, 42), rgb(140, 66, 78), rgb(70, 46, 50), M.WoodPlanks)       -- نوم رئيسية
                    S("nwE", rgb(58, 40, 40), rgb(46, 30, 30), rgb(100, 60, 56), rgb(40, 30, 30), M.Concrete)          -- غرفة الدم
                    S("n2W", rgb(86, 66, 48), rgb(72, 54, 38), rgb(70, 94, 120), rgb(60, 56, 56), M.WoodPlanks)       -- مكتب
                    S("n2E", rgb(40, 40, 52), rgb(30, 30, 40), rgb(60, 36, 46), rgb(26, 26, 32), M.Fabric)            -- سينما
                    S("swW", rgb(70, 74, 82), rgb(52, 56, 64), rgb(86, 92, 100), rgb(60, 64, 70), M.Slate)             -- حمام مهجور
                    S("swE", rgb(146, 130, 108), rgb(120, 104, 86), rgb(172, 156, 126), rgb(120, 112, 100), M.WoodPlanks) -- مرسم
                    S("s2W", rgb(110, 84, 64), rgb(90, 66, 50), rgb(128, 96, 70), rgb(70, 56, 48), M.WoodPlanks)       -- ملابس
                    S("s2E", rgb(210, 160, 176), rgb(184, 134, 154), rgb(226, 184, 196), rgb(200, 170, 180), M.Fabric)  -- غرفة طفل
                    STDEF = {f1 = rgb(62, 58, 70), f2 = rgb(50, 47, 58), wall = rgb(118, 104, 124), ceil = rgb(44, 42, 52), mat = M.Slate}
                end
                local function nearOpenOrVoid(g, x, y)
                    for _, d in ipairs(DIRS) do
                        local nx, ny = x + d[1], y + d[2]
                        if nx >= 1 and nx <= COLS and ny >= 1 and ny <= ROWS then
                            if not g[ny][nx] or (g == wall1 and void1[key(nx, ny)]) then return true end
                        end
                    end
                    return false
                end
                local function buildFloor(f)
                    curFloor, curBase = f, f * FH
                    local g = (f == 0) and wall0 or wall1
                    local inf = H.info[f]
                    local doorKeys = {}
                    for _, dc in ipairs(inf.doors) do doorKeys[key(dc[1], dc[2])] = true end
                    for y = 1, ROWS do
                        for x = 1, COLS do
                            local cx, cz = (x - 0.5) * C, (y - 0.5) * C
                            if not g[y][x] then
                                local st = ST[inf.roomOf[y][x] or ""] or STDEF
                                local fcol = ((x + y) % 2 == 0) and st.f1 or st.f2
                                addStatic(mkPart(scene, Vector3.new(C, 1, C), fcol, CFrame.new(cx, -0.5, cz), nil, st.mat))
                                if not (f == 0 and rampSet[key(x, y)]) then
                                    addStatic(mkPart(scene, Vector3.new(C, 1, C), st.ceil, CFrame.new(cx, WALL_H + 0.5, cz), nil, Enum.Material.Concrete))
                                end
                            elseif not (f == 1 and void1[key(x, y)]) and nearOpenOrVoid(g, x, y) then
                                local col = (f == 0) and Color3.new(0.40, 0.37, 0.43) or Color3.new(0.44, 0.37, 0.37)
                                local wh = WALL_H + 1
                                if f == 0 and wall1[y][x] then wh = FH end
                                addStatic(mkPart(scene, Vector3.new(C, wh, C), col, CFrame.new(cx, wh / 2, cz), nil, Enum.Material.Concrete))
                                -- 🎨 قشرة رقيقة بلون الغرفة على كل وجه ينظر لغرفة
                                for _, d in ipairs(DIRS) do
                                    local nx, ny = x + d[1], y + d[2]
                                    if nx >= 1 and nx <= COLS and ny >= 1 and ny <= ROWS and not g[ny][nx]
                                        and not doorKeys[key(nx, ny)] and not (f == 0 and rampSet[key(nx, ny)])
                                        and not (f == 0 and nx == Ex and ny == Ey) and not (f == 1 and nx == Cx and ny == Cy) then
                                        local st = ST[inf.roomOf[ny][nx] or ""] or STDEF
                                        local sx2 = (d[1] ~= 0) and 0.2 or C
                                        local sz2 = (d[2] ~= 0) and 0.2 or C
                                        addStatic(mkPart(scene, Vector3.new(sx2, WALL_H, sz2), st.wall,
                                            CFrame.new(cx + d[1] * (C / 2 + 0.1), WALL_H / 2, cz + d[2] * (C / 2 + 0.1)), nil, Enum.Material.Concrete))
                                    end
                                end
                            end
                        end
                    end
                end
                buildFloor(0)
                buildFloor(1)
                end
                curFloor, curBase = 0, 0

                -- 🪜 درجات السلم (12 درجة من الأرض لين الدور العلوي)
                do
                    local NSTEP = 12
                    local rdx, rdz = RDX, RDY
                    local stairCol = Color3.fromRGB(86, 70, 62)
                    for i = 1, NSTEP do
                        local mid = (i - 0.5) / NSTEP * 3 * C
                        local h = FH * i / NSTEP
                        local sxp, szp = RSX + rdx * mid, RSY + rdz * mid
                        local sizeX = (rdx ~= 0) and (3 * C / NSTEP) or (C - 0.2)
                        local sizeZ = (rdz ~= 0) and (3 * C / NSTEP) or (C - 0.2)
                        local col = stairCol:Lerp(Color3.fromRGB(110, 92, 80), (i % 2) * 0.35)
                        addStatic(mkPart(scene, Vector3.new(sizeX, h, sizeZ), col, CFrame.new(sxp, h / 2, szp), nil, Enum.Material.Wood))
                    end
                end

                -- 🚪 الباب (أحمر مقفول، يصير أخضر ويفتح لما تجمع المفاتيح) بالجدار الخارجي
                local exitD = {-exitWall[1], -exitWall[2]}
                local ecx, ecz = (exitX - 0.5) * C, (exitY - 0.5) * C
                local dpos = Vector3.new(ecx - exitD[1] * (C / 2 - 0.9), 0, ecz - exitD[2] * (C / 2 - 0.9))
                local dBase = CFrame.lookAt(dpos, dpos + Vector3.new(exitD[1], 0, exitD[2]))
                local DW = 7
                local frameCol = Color3.fromRGB(70, 66, 78)
                addStatic(mkPart(scene, Vector3.new(1.3, 15, 1.5), frameCol, dBase * CFrame.new(-(DW / 2 + 0.7), 7.5, 0), nil, Enum.Material.Concrete))
                addStatic(mkPart(scene, Vector3.new(1.3, 15, 1.5), frameCol, dBase * CFrame.new(DW / 2 + 0.7, 7.5, 0), nil, Enum.Material.Concrete))
                addStatic(mkPart(scene, Vector3.new(DW + 3.4, 1.6, 1.5), frameCol, dBase * CFrame.new(0, 15.8, 0), nil, Enum.Material.Concrete))
                local doorSlab = addStatic(mkPart(scene, Vector3.new(DW, 14.4, 0.7), Color3.fromRGB(96, 68, 48), dBase * CFrame.new(0, 7.2, 0.15), nil, Enum.Material.Wood))
                local doorGlow = mkPart(scene, Vector3.new(DW, 14.4, 0.3), Color3.fromRGB(190, 255, 215), dBase * CFrame.new(0, 7.2, 0.62), nil, Enum.Material.Neon)
                doorGlow.Transparency = 1
                reg(doorGlow, ecx, ecz)
                local doorStrip = mkPart(scene, Vector3.new(DW + 1, 0.5, 0.3), Color3.fromRGB(255, 40, 30), dBase * CFrame.new(0, 14.9, -0.6), nil, Enum.Material.Neon)
                reg(doorStrip, ecx, ecz)
                local padlock = addStatic(mkPart(scene, Vector3.new(1.3, 1.5, 0.6), Color3.fromRGB(215, 175, 55), dBase * CFrame.new(0, 7, -0.45), nil, Enum.Material.Metal))
                local doorProg = 0

                -- 🔑 المفاتيح (مجسّم ذهبي يدور)
                local function makeKeyModel()
                    local model = Instance.new("Model")
                    local gold = Color3.fromRGB(255, 205, 60)
                    local shaft = mkPart(model, Vector3.new(0.45, 3.4, 0.45), gold, CFrame.new(0, 0, 0), nil, Enum.Material.Neon)
                    mkPart(model, Vector3.new(0.5, 2.2, 2.2), gold, CFrame.new(0, 2.3, 0), Enum.PartType.Cylinder, Enum.Material.Neon)
                    mkPart(model, Vector3.new(0.56, 1.0, 1.0), Color3.fromRGB(40, 30, 10), CFrame.new(0, 2.3, 0), Enum.PartType.Cylinder, Enum.Material.SmoothPlastic)
                    mkPart(model, Vector3.new(0.45, 0.5, 1.3), gold, CFrame.new(0, -1.3, 0.8), nil, Enum.Material.Neon)
                    mkPart(model, Vector3.new(0.45, 0.5, 0.9), gold, CFrame.new(0, -0.5, 0.65), nil, Enum.Material.Neon)
                    local glow = mkPart(model, Vector3.new(6, 6, 6), Color3.fromRGB(255, 225, 90), CFrame.new(0, 1.2, 0), Enum.PartType.Ball, Enum.Material.Neon)
                    glow.Transparency = 0.84
                    model.PrimaryPart = shaft
                    return model
                end
                local keyList = {}
                for i, k in ipairs(keyCells) do
                    keyList[i] = {
                        model = makeKeyModel(), taken = false, shown = false, f = k[3],
                        x = (k[1] - 0.5) * C, z = (k[2] - 0.5) * C,
                    }
                end

                -- 💡 اللمبات المعلّقة (تولع وتطفي وتنتفض)
                local LAMP_ON = Color3.fromRGB(255, 214, 140)
                local LAMP_OFF = Color3.fromRGB(48, 42, 38)
                local function setLampVisual(l, on)
                    l.bulb.Color = on and LAMP_ON or LAMP_OFF
                    l.bulb.Material = on and Enum.Material.Neon or Enum.Material.SmoothPlastic
                    l.halo.Transparency = on and 0.8 or 1
                    l.pool.Transparency = on and 0.86 or 1
                end
                local function makeLamp(cx, cz, f)
                    curFloor, curBase = f, f * FH
                    addStatic(mkPart(scene, Vector3.new(0.22, 4, 0.22), Color3.fromRGB(50, 50, 54), CFrame.new(cx, WALL_H - 2, cz), nil, Enum.Material.Metal))
                    addStatic(mkPart(scene, Vector3.new(0.9, 4.2, 4.2), Color3.fromRGB(58, 64, 58), CFrame.new(cx, 15.9, cz) * FLAT, Enum.PartType.Cylinder, Enum.Material.Metal))
                    local bulb = mkPart(scene, Vector3.new(1.7, 1.7, 1.7), LAMP_ON, CFrame.new(cx, 15.0, cz), Enum.PartType.Ball, Enum.Material.Neon)
                    local halo = mkPart(scene, Vector3.new(6, 6, 6), LAMP_ON, CFrame.new(cx, 15.0, cz), Enum.PartType.Ball, Enum.Material.Neon)
                    local pool = mkPart(scene, Vector3.new(0.15, 14, 14), LAMP_ON, CFrame.new(cx, 0.12, cz) * FLAT, Enum.PartType.Cylinder, Enum.Material.Neon)
                    reg(bulb, cx, cz)
                    reg(halo, cx, cz)
                    reg(pool, cx, cz)
                    local l = {
                        x = cx, z = cz, f = f, on = true, bulb = bulb, halo = halo, pool = pool,
                        timer = rnd(1.5, 6), flick = 0, flickT = 0, dead = 0,
                    }
                    setLampVisual(l, true)
                    table.insert(lamps, l)
                    curFloor, curBase = 0, 0
                end
                for _, c in ipairs(lampCells) do
                    makeLamp((c[1] - 0.5) * C, (c[2] - 0.5) * C, c[3])
                end


                -- 🚪🕰️🛋️ الأبواب + الساعات + الدولاب + البطاريات + ديكور كل غرفة (كل غرفة بستايل مختلف)
                local doors, batList = {}, {}
                local doorAt = {[0] = {}, [1] = {}}
                local CAB = {x = 0, z = 0, f = 0, solved = false}
                local CP = {open = false, solved = false, near = false, x = 0, z = 0, f = 0} -- 🎨 لغز الألوان
                do
                    local rgb = Color3.fromRGB
                    local function cellW(x, y) return (x - 0.5) * C, (y - 0.5) * C end
                    local function box(b, ox, oy, oz, sx, sy, sz, col, mat)
                        return addStatic(mkPart(scene, Vector3.new(sx, sy, sz), col, b * CFrame.new(ox, oy + sy / 2, oz), nil, mat or Enum.Material.SmoothPlastic))
                    end
                    local function cyl(b, ox, oy, oz, h, d, col, mat)
                        return addStatic(mkPart(scene, Vector3.new(h, d, d), col, b * CFrame.new(ox, oy + h / 2, oz) * FLAT, Enum.PartType.Cylinder, mat or Enum.Material.SmoothPlastic))
                    end
                    -- قاعدة الأثاث الملاصق للجدار: z موجب = ناحية الجدار، z سالب = داخل الغرفة
                    local function slotBase(s)
                        local p = Vector3.new((s.x - 0.5) * C - s.nx * (C / 2 - 0.3), 0, (s.y - 0.5) * C - s.ny * (C / 2 - 0.3))
                        return CFrame.lookAt(p, p + Vector3.new(s.nx, 0, s.ny))
                    end
                    local function freeBase(x, z, rot) return CFrame.new(x, 0, z) * CFrame.Angles(0, rot or 0, 0) end
                    local function wz(depth) return 0.25 - depth / 2 end
                    local function rc(r)
                        return ((r.x0 + r.x1) / 2 - 0.5) * C, ((r.y0 + r.y1) / 2 - 0.5) * C, (r.x1 - r.x0 + 1) * C, (r.y1 - r.y0 + 1) * C
                    end
                    local function newPicker(f, r)
                        local sl = roomSlots(f, r)
                        shuffle(sl)
                        local used = {}
                        return function()
                            for i, s in ipairs(sl) do
                                local k = key(s.x, s.y)
                                if not used[k] and not used[k + 1] and not used[k - 1] and not used[k + 1000] and not used[k - 1000] then
                                    used[k] = true
                                    table.remove(sl, i)
                                    return s
                                end
                            end
                            return nil
                        end
                    end
                    local WOOD1, WOOD2 = rgb(98, 68, 46), rgb(70, 48, 34)
                    local BLOODC = rgb(108, 12, 14)

                    -- 🩸 دم
                    local function bloodPool(x, z, d)
                        addStatic(mkPart(scene, Vector3.new(0.08, d, d), BLOODC, CFrame.new(x, 0.06, z) * FLAT, Enum.PartType.Cylinder), BLOODC, x, z)
                        for _ = 1, 3 do
                            local a = math.random() * 6.28
                            local r2 = d * (0.2 + math.random() * 0.25)
                            local qx, qz = x + math.cos(a) * d * 0.45, z + math.sin(a) * d * 0.45
                            addStatic(mkPart(scene, Vector3.new(0.07, r2, r2), BLOODC, CFrame.new(qx, 0.065, qz) * FLAT, Enum.PartType.Cylinder), BLOODC, qx, qz)
                        end
                    end
                    local function bloodWall(s, hand)
                        local b = slotBase(s)
                        for _ = 1, math.random(2, 4) do
                            local ox = (math.random() - 0.5) * 7
                            local len = 2 + math.random() * 6
                            box(b, ox, 12 - len, 0.2, 0.5 + math.random() * 0.5, len, 0.06, BLOODC)
                        end
                        if hand then
                            local ox = (math.random() - 0.5) * 4
                            box(b, ox, 5, 0.2, 1.5, 1.6, 0.06, BLOODC)
                            for k = -1, 1 do box(b, ox + k * 0.5, 6.5, 0.2, 0.28, 1.2, 0.06, BLOODC) end
                        end
                    end
                    local function frameAt(s, w, h, col)
                        local b = slotBase(s)
                        box(b, 0, 6.2, 0.12, w + 0.8, h + 0.8, 0.2, rgb(72, 54, 32), Enum.Material.Wood)
                        box(b, 0, 6.2, 0.0, w, h, 0.12, col)
                    end

                    -- 🪑 قطع أثاث مشتركة
                    local function bedAt(s, w, len, sheet, wood)
                        local b = slotBase(s)
                        box(b, 0, 0, wz(len), w, 1.6, len, wood or WOOD2, Enum.Material.Wood)
                        box(b, 0, 1.6, wz(len) - 0.1, w - 0.5, 0.9, len - 0.6, sheet, Enum.Material.Fabric)
                        box(b, 0, 2.5, 0.25 - 1.5, w - 1.4, 0.55, 1.9, rgb(235, 232, 225), Enum.Material.Fabric)
                        box(b, 0, 0, 0.1, w, 4.4, 0.4, wood or WOOD2, Enum.Material.Wood)
                    end
                    local function stand(s, col)
                        local b = slotBase(s)
                        box(b, 0, 0, wz(2.4), 2.6, 2.4, 2.4, col or WOOD1, Enum.Material.Wood)
                        cyl(b, 0, 2.4, wz(2.4), 0.7, 1.4, rgb(240, 220, 150), Enum.Material.Neon)
                    end
                    local function wardrobeAt(s, col)
                        local b = slotBase(s)
                        box(b, 0, 0, wz(3), 6.4, 13, 3, col or WOOD2, Enum.Material.Wood)
                        box(b, -1.6, 0.5, wz(3) - 1.55, 3, 11.8, 0.2, (col or WOOD2):Lerp(Color3.new(1, 1, 1), 0.12), Enum.Material.Wood)
                        box(b, 1.6, 0.5, wz(3) - 1.55, 3, 11.8, 0.2, (col or WOOD2):Lerp(Color3.new(1, 1, 1), 0.12), Enum.Material.Wood)
                        box(b, -0.3, 6, wz(3) - 1.7, 0.2, 1, 0.2, rgb(210, 170, 60), Enum.Material.Metal)
                        box(b, 0.3, 6, wz(3) - 1.7, 0.2, 1, 0.2, rgb(210, 170, 60), Enum.Material.Metal)
                    end
                    local function shelfAt(s, col, rows)
