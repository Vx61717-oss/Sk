                                        local ax = math.abs(dir.X) > 1e-3 and (W / 2 - mg) / math.abs(dir.X) or math.huge
                                        local ay = math.abs(dir.Y) > 1e-3 and (H / 2 - mg) / math.abs(dir.Y) or math.huge
