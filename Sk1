                -- 🏠 توليد البيت: دورين (أرضي + علوي)، غرف وممرات وأبواب + سلم يربط الدورين
                local function key(x, y) return y * 1000 + x end
                local function shuffle(t)
                    for i = #t, 2, -1 do
                        local j = math.random(i)
                        t[i], t[j] = t[j], t[i]
                    end
                end
                local MINR = 3 -- أصغر غرفة (بالخانات)
                local function newGrid()
                    local g = {}
                    for y = 1, ROWS do
                        g[y] = {}
                        for x = 1, COLS do g[y][x] = true end
                    end
                    return g
                end

                -- تقسيم الدور لغرف (BSP) وكل غرفتين متجاورتين بينهم باب
                local function genFloor()
                    local g = newGrid()
                    local function carve(x0, y0, x1, y1)
                        for y = y0, y1 do
                            for x = x0, x1 do g[y][x] = false end
                        end
                    end
                    local function addDoors(vertical, s, a0, a1)
                        local cands = {}
                        for k = a0, a1 do
                            local ok
                            if vertical then
                                ok = (not g[k][s - 1]) and (not g[k][s + 1])
                            else
                                ok = (not g[s - 1][k]) and (not g[s + 1][k])
                            end
                            if ok then cands[#cands + 1] = k end
                        end
                        if #cands == 0 then return end
                        local function setDoor(k)
                            if vertical then g[k][s] = false else g[s][k] = false end
                        end
                        local first = cands[math.random(#cands)]
                        setDoor(first)
                        if #cands >= 6 and math.random() < 0.5 then
                            for _ = 1, 8 do
                                local k2 = cands[math.random(#cands)]
                                if math.abs(k2 - first) >= 3 then
                                    setDoor(k2)
                                    break
                                end
                            end
                        end
                    end
                    local function split(x0, y0, x1, y1)
                        local w, h = x1 - x0 + 1, y1 - y0 + 1
                        local canV = w >= 2 * MINR + 1
                        local canH = h >= 2 * MINR + 1
                        local big = (w > 9 or h > 9)
                        if (not canV and not canH) or (not big and math.random() < 0.45) then
                            carve(x0, y0, x1, y1)
                            return
                        end
                        local vertical
                        if canV and canH then
                            if w > h * 1.25 then vertical = true
                            elseif h > w * 1.25 then vertical = false
                            else vertical = math.random() < 0.5 end
                        else
                            vertical = canV
                        end
                        if vertical then
                            local s = math.random(x0 + MINR, x1 - MINR)
                            split(x0, y0, s - 1, y1)
                            split(s + 1, y0, x1, y1)
                            addDoors(true, s, y0, y1)
                        else
                            local s = math.random(y0 + MINR, y1 - MINR)
                            split(x0, y0, x1, s - 1)
                            split(x0, s + 1, x1, y1)
                            addDoors(false, s, x0, x1)
                        end
                    end
                    split(2, 2, COLS - 1, ROWS - 1)
                    return g
                end

                -- 🏰 هيكل القصر (بدون ديكور):
                -- الدور الأرضي: الباب وراك، الدرج قدامك، غرفة يمين وغرفة يسار تحت الدرج، وغرف جانبية وقاعة خلفية
                -- الدور الثاني: ممر طويل يمين ويسار وفيه غرف على الجهتين
                local function genPalace(f)
                    local g = newGrid()
                    local M = COLS + 1
                    local info = {doors = {}, rooms = {}, roomOf = {}}
                    for y = 1, ROWS do info.roomOf[y] = {} end
                    local function rect(x0, y0, x1, y1)
                        for y = y0, y1 do
                            for x = x0, x1 do g[y][x] = false end
                        end
                    end
                    local function room(name, x0, y0, x1, y1)
                        rect(x0, y0, x1, y1)
                        info.rooms[#info.rooms + 1] = {name = name, x0 = x0, y0 = y0, x1 = x1, y1 = y1}
                        for y = y0, y1 do
                            for x = x0, x1 do info.roomOf[y][x] = name end
                        end
                    end
                    local function mroom(name, x0, y0, x1, y1)
                        room(name .. "W", x0, y0, x1, y1)
                        room(name .. "E", M - x1, y0, M - x0, y1)
                    end
                    local function door(x, y)
                        g[y][x] = false
                        info.doors[#info.doors + 1] = {x, y}
                    end
                    local function mdoor(x, y) door(x, y) door(M - x, y) end
                    if f == 0 then
                        room("lobby", 11, 21, 23, 24)     -- اللوبي (الباب الخارجي وراك والدرج قدامك)
                        mroom("flank", 11, 13, 15, 19)    -- غرفة يمين وغرفة يسار تحت الدرج
                        room("dining", 11, 4, 23, 11)     -- القاعة الخلفية
                        mroom("rear", 2, 4, 9, 11)        -- غرف جانبية خلفية
                        mroom("frontUp", 2, 13, 9, 18)    -- غرف جانبية أمامية (فوق)
                        mroom("frontLo", 2, 20, 9, 24)    -- غرف جانبية أمامية (تحت)
                        mdoor(math.random(12, 14), 20)
                        mdoor(math.random(12, 14), 12)
                        mdoor(10, math.random(5, 10))
                        mdoor(10, math.random(14, 17))
                        mdoor(10, math.random(21, 23))
                    else
                        room("corridor", 2, 15, COLS - 1, 16)  -- الممر الطويل (يمين ويسار فوق الدرج)
                        mroom("nw", 2, 4, 8, 13)
                        mroom("n2", 10, 4, 16, 13)
                        mroom("sw", 2, 18, 8, 24)
                        mroom("s2", 10, 18, 14, 24)
                        mdoor(math.random(3, 7), 14)
                        mdoor(math.random(11, 15), 14)
                        mdoor(math.random(3, 7), 17)
                        mdoor(math.random(11, 13), 17)
                    end
                    return g, info
                end

                -- يوصّل أي جزر منفصلة (بعد وضع السلم) عن طريق حفر أقصر ممر
                local function connectFix(g, prot)
                    local function label()
                        local comp, sizes, n = {}, {}, 0
                        for y = 1, ROWS do comp[y] = {} end
                        for y = 2, ROWS - 1 do
                            for x = 2, COLS - 1 do
