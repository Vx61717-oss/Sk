    -- ====================== Heartbeat Loop ======================
    RunService.Heartbeat:Connect(function(HeartbeatDelta)
        local Lighting = game:GetService("Lighting")
        if State.NoFallActive then
            local char = LocalPlayer.Character; local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum and hum:GetState() == Enum.HumanoidStateType.Freefall then 
                hum:ChangeState(Enum.HumanoidStateType.Climbing) 
            end
        end

        if State.FullBrightActive then
            Lighting.Brightness = 2; Lighting.ClockTime = 14; Lighting.GlobalShadows = false; Lighting.Ambient = Color3.fromRGB(255, 255, 255)
        else 
            Lighting.Brightness = _originalBrightness
            Lighting.ClockTime = _originalClockTime
            Lighting.Ambient = _originalAmbient
            Lighting.GlobalShadows = _originalGlobalShadows
        end
        
        if State.SmartFollowActive then
            local nearest; local minD = math.huge
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    local d = (LocalPlayer.Character.HumanoidRootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude
                    if d < minD then minD = d; nearest = p end
                end
            end
            if nearest then 
                LocalPlayer.Character.HumanoidRootPart.CFrame = nearest.Character.HumanoidRootPart.CFrame * CFrame.new(0, 5, 2) 
            end
        end

        -- 🧠 التطيير الجديد:
        -- إذا ابتعد الهدف عنك 1000 متر/ستد، نوقف التطيير داخليًا فقط.
        -- عند Respawn الهدف يعاد تشغيل التطيير مع بقاء الزر الخارجي مفعلاً.
        if State.flingEnabled and State.selectedPlayer then
            local targetChar = State.selectedPlayer.Character
            local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
            local myChar = LocalPlayer.Character
            local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

            if targetRoot and myRoot then
                local distanceFromMe = (targetRoot.Position - myRoot.Position).Magnitude
                if distanceFromMe >= State._flingDistanceLimit then
                    State._flingAutoPaused = true
                    -- إيقاف داخلي فقط؛ لا نطفئ زر التطيير الخارجي.
                    State.flingEnabled = false
                end
            end

            local startCFrame = State._flingStartCFrame or State.lastLocation
            if targetRoot and startCFrame then
                local distanceFromStart = (targetRoot.Position - startCFrame.Position).Magnitude

                if distanceFromStart >= State._flingDistanceLimit and not State._flingReturned then
                    State._flingTooFar = true
                    State._flingReturned = true

                    local myChar = LocalPlayer.Character
                    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                    if myRoot then
                        myRoot.Anchored = false
                        myRoot.CFrame = startCFrame
                        myRoot.AssemblyLinearVelocity = Vector3.zero
                        myRoot.AssemblyAngularVelocity = Vector3.zero
                    end
                end
            end
        end

        if State.selectedPlayer and State.selectedPlayer.Character then
            local tChar = State.selectedPlayer.Character
            if State.sittingOnHead and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then 
                LocalPlayer.Character.HumanoidRootPart.CFrame = tChar:GetModelCFrame() * CFrame.new(0, 4, 0) 
            end

            -- بانق: حركة سريعة خلف اللاعب فقط، ولا تدخل أمامه أبداً.
            if State.hmmActive then
                local myChar = LocalPlayer.Character
                local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                local targetRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")

                if myRoot and targetRoot then
                    State._hmmPhase = (State._hmmPhase or 0) + 0.65 * (State.BangSpeed or 1)

                    -- حدّ الحركة يكون عند مسافة قريبة خلف اللاعب فقط،
                    -- ثم يرجع للخلف بدون أن يتجاوز نقطة الوقوف خلفه.
                    local minBehindDistance = 1.15
                    local maxBehindDistance = 2.75
                    local wave = (math.sin(State._hmmPhase) + 1) * 0.5
                    local behindDistance = minBehindDistance + wave * (maxBehindDistance - minBehindDistance)
                    -- نفس حركة الرجوع والتقدم الأصلية، لكن على نقطة متوقعة
                    -- حتى يعوض فرق الاتصال أثناء مشي الهدف.
                    if State._hmmTargetPlayer ~= State.selectedPlayer then
                        State._hmmTargetPlayer = State.selectedPlayer
                        State._hmmLastTargetPosition = nil
                        State._hmmVelocity = nil
                    end

                    local dt = math.clamp(HeartbeatDelta or 0.05, 0.016, 0.20)
                    local currentTargetPosition = targetRoot.Position
                    local measuredVelocity = Vector3.zero
                    if State._hmmLastTargetPosition then
                        measuredVelocity = (currentTargetPosition - State._hmmLastTargetPosition) / dt
                    end
                    State._hmmLastTargetPosition = currentTargetPosition

                    local targetVelocity = targetRoot.AssemblyLinearVelocity
                    if targetVelocity.Magnitude < 1 then
                        local targetHumanoid = tChar:FindFirstChildOfClass("Humanoid")
                        if targetHumanoid and targetHumanoid.MoveDirection.Magnitude > 0.01 then
                            targetVelocity = targetHumanoid.MoveDirection * targetHumanoid.WalkSpeed
                        end
                    end
                    if measuredVelocity.Magnitude > targetVelocity.Magnitude then
                        targetVelocity = measuredVelocity
                    end
                    targetVelocity = Vector3.new(targetVelocity.X, 0, targetVelocity.Z)
                    if targetVelocity.Magnitude > 32 then
                        targetVelocity = targetVelocity.Unit * 32
                    end

                    State._hmmVelocity = State._hmmVelocity
                        and State._hmmVelocity:Lerp(targetVelocity, 0.35)
                        or targetVelocity

                    -- إذا كان الهدف يمشي بوضوح، نوقف تذبذب قدام/ورا
                    -- ونبقى خلفه بثبات. الحركة البطيئة جدًا تبقي التذبذب الطبيعي.
                    local slowWalkThreshold = 5.5
                    if State._hmmVelocity.Magnitude > slowWalkThreshold then
                        behindDistance = (minBehindDistance + maxBehindDistance) * 0.5
                    end

                    -- تعويض ديناميكي حسب Ping الهدف واتصالك بدل قيمة ثابتة.
                    -- نرجعه قليلًا عن القيمة السابقة حتى لا يتقدم أكثر من اللازم.
                    local targetPing = 0.08
                    local myPing = 0.08
                    pcall(function()
                        targetPing = tonumber(State.selectedPlayer:GetNetworkPing()) or targetPing
                    end)
                    pcall(function()
                        myPing = tonumber(LocalPlayer:GetNetworkPing()) or myPing
                    end)
                    -- بعض المشغلات قد تعيد القيمة بالميلي ثانية بدل الثانية.
                    if targetPing > 2 then targetPing = targetPing / 1000 end
                    if myPing > 2 then myPing = myPing / 1000 end
                    local connectionDelay = math.clamp((targetPing + myPing) * 0.5, 0.03, 0.35)
                    -- زيادة بسيطة فقط لتقليل المسافة المتبقية.
                    local leadTime = math.clamp(0.34 + connectionDelay * 1.05, 0.34, 0.54)
                    if State._hmmVelocity.Magnitude > 14 then
                        leadTime = math.clamp(leadTime + 0.10, 0.36, 0.62)
                    end
                    local predictedPosition = currentTargetPosition + State._hmmVelocity * leadTime
                    local targetPos = predictedPosition - targetRoot.CFrame.LookVector * behindDistance

                    local targetCF = CFrame.lookAt(
                        Vector3.new(targetPos.X, currentTargetPosition.Y, targetPos.Z),
                        Vector3.new(
                            predictedPosition.X,
                            currentTargetPosition.Y,
                            predictedPosition.Z
                        )
                    )

                    myRoot.CFrame = targetCF
                    myRoot.AssemblyLinearVelocity = Vector3.zero
                    myRoot.AssemblyAngularVelocity = Vector3.zero
                end
            end

            -- بانق 2: نفس فكرة التوقع، لكن فوق رأس اللاعب مع وضع الجلوس.
            if State.headBangActive then
                local myChar = LocalPlayer.Character
                local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                local myHumanoid = myChar and myChar:FindFirstChildOfClass("Humanoid")
                local targetRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
                local targetHead = tChar and tChar:FindFirstChild("Head")

                if myRoot and myHumanoid and targetRoot and targetHead then
                    local headVelocity = targetRoot.AssemblyLinearVelocity
                    if headVelocity.Magnitude < 1 then
                        local targetHumanoid = tChar:FindFirstChildOfClass("Humanoid")
                        if targetHumanoid and targetHumanoid.MoveDirection.Magnitude > 0.01 then
                            headVelocity = targetHumanoid.MoveDirection * targetHumanoid.WalkSpeed
                        end
                    end
                    headVelocity = Vector3.new(headVelocity.X, 0, headVelocity.Z)
                    if headVelocity.Magnitude > 32 then
                        headVelocity = headVelocity.Unit * 32
                    end

                    local headPing = 0.08
                    local localPing = 0.08
                    pcall(function()
                        headPing = tonumber(State.selectedPlayer:GetNetworkPing()) or headPing
                    end)
                    pcall(function()
                        localPing = tonumber(LocalPlayer:GetNetworkPing()) or localPing
                    end)
                    if headPing > 2 then headPing = headPing / 1000 end
                    if localPing > 2 then localPing = localPing / 1000 end
                    local headLead = math.clamp(0.38 + ((headPing + localPing) * 0.5) * 1.15, 0.38, 0.62)
                    local predictedHead = targetHead.Position + headVelocity * headLead

                    -- بانق 2 يكون أمام الوجه، مع نفس حركة الرجوع والتقدم.
                    State._headBangPhase = (State._headBangPhase or 0) + 0.65 * (State.BangSpeed or 1)
                    local frontMinDistance = 1.15
                    local frontMaxDistance = 2.75
                    local frontWave = (math.sin(State._headBangPhase) + 1) * 0.5
                    local frontDistance = frontMinDistance + frontWave * (frontMaxDistance - frontMinDistance)
                    local faceDirection = targetRoot.CFrame.LookVector
                    local sitPosition = predictedHead + faceDirection * frontDistance
                    local sitCF = CFrame.lookAt(sitPosition, predictedHead)

                    myRoot.CFrame = sitCF
                    myRoot.AssemblyLinearVelocity = Vector3.zero
                    myRoot.AssemblyAngularVelocity = Vector3.zero
                    myHumanoid.Sit = true
                    myHumanoid:ChangeState(Enum.HumanoidStateType.Seated)
                end
            end

            if State.flingEnabled and not State._flingTooFar and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local myRoot = LocalPlayer.Character.HumanoidRootPart
                local myHum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                -- ✅ حماية من الموت أثناء التطيير
                if myHum then
                    myHum.Health = myHum.MaxHealth
                end
                -- 🎯 نفس تتبع نــ-ـيـ-ك: سرعة الهدف + MoveDirection + Ping + توقع موقعه القادم
                local flingTargetRoot = tChar:FindFirstChild("HumanoidRootPart")
                if flingTargetRoot then
                    local flingVelocity = flingTargetRoot.AssemblyLinearVelocity
                    if flingVelocity.Magnitude < 1 then
                        local targetHumanoid = tChar:FindFirstChildOfClass("Humanoid")
                        if targetHumanoid and targetHumanoid.MoveDirection.Magnitude > 0.01 then
                            flingVelocity = targetHumanoid.MoveDirection * targetHumanoid.WalkSpeed
                        end
                    end

                    flingVelocity = Vector3.new(flingVelocity.X, 0, flingVelocity.Z)
                    if flingVelocity.Magnitude > 32 then
                        flingVelocity = flingVelocity.Unit * 32
                    end

                    local targetPing = 0.08
                    local myPing = 0.08
                    pcall(function()
                        targetPing = tonumber(State.selectedPlayer:GetNetworkPing()) or targetPing
                    end)
                    pcall(function()
                        myPing = tonumber(LocalPlayer:GetNetworkPing()) or myPing
                    end)
                    if targetPing > 2 then targetPing = targetPing / 1000 end
                    if myPing > 2 then myPing = myPing / 1000 end

                    -- نمدد التوقع قليلًا حتى يعوض فرق الاتصال بينك وبين الهدف.
                    local connectionDelay = math.clamp((targetPing + myPing) * 0.5, 0.03, 0.50)
                    local leadTime = math.clamp(0.45 + connectionDelay * 1.20, 0.45, 0.70)
                    if flingVelocity.Magnitude > 14 then
                        leadTime = math.clamp(leadTime + 0.12, 0.48, 0.82)
                    end

                    local predictedPosition = flingTargetRoot.Position + flingVelocity * leadTime

                    -- نثبت قرب الموقع المتوقع بدل الموقع القديم، عشان ما يتأخر التطيير عن الهدف وهو يمشي.
                    myRoot.CFrame = CFrame.lookAt(
                        predictedPosition + flingTargetRoot.CFrame.LookVector,
                        predictedPosition
                    )
                    myRoot.Velocity = Vector3.new(9999, 9999, 9999)
                    myRoot.RotVelocity = Vector3.new(9999, 9999, 9999)
                end
            end
        end
    end)

