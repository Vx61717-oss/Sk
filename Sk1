                        a.speaking = nil
                        a.gap = 4 + math.random() * 3 -- بعد ما يضيعك ما يتكلم فوراً
                        for _, snd in ipairs(a.sounds) do
                            if snd.IsPlaying then pcall(function() snd:Stop() end) end
                        end
                        return
                    end

                    -- يتكلم الحين: ننتظر يخلص الصوت كامل
                    if a.speaking then
                        local el = os.clock() - a.startedAt
                        local len = math.max(a.speaking.TimeLength or 0, 1)
                        if el > len + 0.25 or (el > 0.6 and not a.speaking.IsPlaying) then
                            a.speaking = nil
                            a.gap = a.pickGap()
                        end
                        return
                    end

                    a.gap = a.gap - dt
