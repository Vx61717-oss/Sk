                    local hs = (sk.shape == "ball") and 3 or 2.9
                    head.Size = Vector3.new(hs, hs, hs)
                    head.Color = flashRed and RED or skinColor(sk, 1, n, t)
                    if sk.shape == "diamond" then
                        head.CFrame = CFrame.new(hp) * CFrame.Angles(t * 2, yawHead, 0.615)
                    else
