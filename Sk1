                    local function rug(x, z, w, l, col)
                        addStatic(mkPart(scene, Vector3.new(w, 0.1, l), col, CFrame.new(x, 0.06, z), nil, Enum.Material.Fabric))
                    end
                    local function crate(x, z, s, rot)
                        local b = freeBase(x, z, rot)
                        box(b, 0, 0, 0, s, s, s, rgb(120 + math.random(-15, 15), 86, 50), Enum.Material.Wood)
                        box(b, 0, s * 0.45, 0, s + 0.1, s * 0.1, s + 0.1, rgb(80, 56, 34), Enum.Material.Wood)
                    end
                    local function tubAt(s, col)
                        local b = slotBase(s)
                        box(b, 0, 0, wz(11), 5.6, 2.4, 11, col, Enum.Material.SmoothPlastic)
                        box(b, 0, 2.3, wz(11), 4.4, 0.2, 9.8, rgb(150, 190, 210), Enum.Material.Glass)
                    end
