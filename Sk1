-- 🔁 إشعارات "حية" تتحدث بنفسها بدل ما تتكدس: تستخدمها القيم المتغيرة بسرعة
-- (زيادة/نقصان الجاذبية، السرعة، وغيرها) عشان يبقى إشعار واحد بس يتحدث رقمه.
local _liveNotifFrames = {}

-- ينتظر ويطفي الإشعار بعد مدته؛ لو صار تحديث أحدث لنفس liveKey أثناء الانتظار
-- (رقم Gen تغيّر) يتوقف هذا الإخفاء القديم ويسيب المهمة للتحديث الأحدث.
-- يختفي كل محتوى الإشعار مع بعض:
-- الخلفية + الحواف + الـGlow + الشريط + الصورة + كل النصوص والعناصر الداخلية.
-- الاعتماد على جميع العناصر الداخلية يمنع بقاء أي عنصر ظاهر لو أضيف عنصر جديد لاحقًا.
_fadeNotificationContents = function(I, duration)
    if not I or not I.Parent then return end

    for _, obj in ipairs(I:GetDescendants()) do
        if obj:IsA("UIStroke") then
            SkyTw(obj, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                Transparency = 1
            }):Play()

        elseif obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            SkyTw(obj, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                TextTransparency = 1,
                BackgroundTransparency = 1
            }):Play()

        elseif obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
            SkyTw(obj, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                ImageTransparency = 1,
                BackgroundTransparency = 1
            }):Play()

        elseif obj:IsA("Frame") or obj:IsA("ScrollingFrame") or obj:IsA("ViewportFrame") then
            SkyTw(obj, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                BackgroundTransparency = 1
            }):Play()
        end
    end

    SkyTw(I, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        BackgroundTransparency = 1
    }):Play()
end

-- ينتظر ويطفي الإشعار بعد مدته؛ لو صار تحديث أحدث لنفس liveKey أثناء الانتظار
-- (رقم Gen تغيّر) يتوقف هذا الإخفاء القديم ويسيب المهمة للتحديث الأحدث.
local function _dismissNotificationAfterDelay(F, I, Stroke, TL, ML, AvatarImg, category, gen, liveKey)
    task.wait(category == "presence" and 3.2 or 2.8)
    if not F.Parent then return end
    if F:GetAttribute("Dismissing") then return end
    if gen ~= nil and F:GetAttribute("Gen") ~= gen then return end

    -- نخفي كل عناصر الإشعار في نفس الوقت ثم نحرك الحاوية للخارج.
    _fadeNotificationContents(I, 0.55)
    SkyTw(I, TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Position = UDim2.new(0, 330, 0, 0)
    }):Play()

    task.wait(0.56)
    removeNotificationRecord(category, F)
    if F.Parent then F:Destroy() end
    if liveKey and _liveNotifFrames[liveKey] == F then _liveNotifFrames[liveKey] = nil end
end

