                        addStatic(mkPart(scene, Vector3.new(0.3, 4.6, 4.6), rgb(238, 232, 214), b * CFrame.new(0, Y, 0.22) * CFrame.Angles(0, math.pi / 2, 0), Enum.PartType.Cylinder))
                        for hr = 0, 11 do
