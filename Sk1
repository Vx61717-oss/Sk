            local function getPlayerPower()
                local upgradePower = (lv.rate or 0) * 0.8 + (lv.range or 0) * 0.35
                    + (lv.mag or 0) * 0.45 + (lv.dmg or 0) * 1.25
                    + (lv.gren or 0) * 0.75 + (lv.knife or 0) * 0.9
                    + (lv.kspeed or 0) * 0.4 + (lv.bolt or 0) * 0.65
                local weaponPower = (pistolOwned and 1.2 or 0)
                    + (grenOwned and 0.8 or 0) + (knifeOwned and 0.7 or 0)
                    + (boltOwned and 0.9 or 0) + (pulseOwned and 0.7 or 0) + (freezeOwned and 0.8 or 0)
                return math.clamp(upgradePower + weaponPower, 0, 14)
            end

