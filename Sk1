                    pcall(function() if _G.SkyGameAudio then _G.SkyGameAudio.End("horror") end end)
                end

                -- 👁️ هل الوحش يشوفك؟ (مدى + زاوية رؤية + ما في جدار بينكم)
                local function losOpen(f, cx, cy)
                    if cx < 1 or cx > COLS or cy < 1 or cy > ROWS then return false end
                    if f == 0 then return (not wall0[cy][cx]) or (cx == Ex and cy == Ey) end
                    return (not wall1[cy][cx]) or void1[key(cx, cy)] == true
                end
                local function clearLine(f, x1, y1, x2, y2)
                    local dx, dy = x2 - x1, y2 - y1
                    local dist = math.sqrt(dx * dx + dy * dy)
                    local n = math.max(1, math.ceil(dist / (C * 0.3)))
                    for i = 1, n do
                        local tt = i / n
                        local cx, cy = math.floor((x1 + dx * tt) / C) + 1, math.floor((y1 + dy * tt) / C) + 1
                        if not losOpen(f, cx, cy) then return false end
                        local dd = doorAt[f][key(cx, cy)]
                        if dd and dd.open < 0.5 then return false end
                    end
                    return true
                end
                local function canSeePlayer()
                    if adminMonsterBlind then return false end
                    if H.hs and H.hs.on then return false end -- 🚪 مختبئ بالدولاب
                    if state ~= "play" or mf ~= pf then return false end
                    if math.abs(mElev - pElev) > 12 then return false end
                    local dx, dz = px - mx, py - my
                    local d = math.sqrt(dx * dx + dz * dz)
                    if d > SIGHT_RANGE then return false end
                    if d > NEAR_SENSE then
                        local dot = (dx * mFace.X + dz * mFace.Z) / d
                        if dot < FOV_COS then return false end
                    end
                    return clearLine(mf, mx, my, px, py)
                end

                local function faceToward(dx, dz, dt, rate)
                    local m = math.sqrt(dx * dx + dz * dz)
                    if m > 0.01 then
                        local nd = mFace:Lerp(Vector3.new(dx / m, 0, dz / m), math.min(1, dt * (rate or 6)))
                        if nd.Magnitude > 0.01 then mFace = nd.Unit end
                    end
                end

                local function monsterMoveTo(tx, ty, speed, dt)
                    if H.hs.stagger > 0 then speed = 0 end -- 😵 يتجمد لحظة بعد ما يضربك
                    local dxm, dym = tx - mx, ty - my
                    local dm = math.sqrt(dxm * dxm + dym * dym)
                    if dm > 0.001 then
                        local stp = math.min(dm, speed * dt)
                        mx, my = mx + dxm / dm * stp, my + dym / dm * stp
                        return dxm / dm, dym / dm
                    end
                    return 0, 0
                end

                -- يمشي الوحش خطوة باتجاه الهدف حسب خريطة المسافات (تشمل السلم)
                local function navStep(dmap, dt, speed, exactX, exactY)
                    local cx, cy = math.floor(mx / C) + 1, math.floor(my / C) + 1
                    local cur = dmap and dmap[mf] and dmap[mf][cy] and dmap[mf][cy][cx]
                    local tx, ty = (cx - 0.5) * C, (cy - 0.5) * C
                    if cur and cur > 0 then
                        local best, bx, by = cur, nil, nil
                        for _, n in ipairs(nbrs3(mf, cx, cy)) do
                            local v = dmap[n[1]][n[3]][n[2]]
                            if v and v < best then best, bx, by = v, n[2], n[3] end
                        end
                        if bx then tx, ty = (bx - 0.5) * C, (by - 0.5) * C end
                    elseif cur == 0 and exactX then
                        tx, ty = exactX, exactY
                    end
                    local ux, uy = monsterMoveTo(tx, ty, speed, dt)
                    local ncx, ncy = math.floor(mx / C) + 1, math.floor(my / C) + 1
                    if mf == 0 and ncx == Ex and ncy == Ey then mf = 1
                    elseif mf == 1 and ncx == Cx and ncy == Cy then mf = 0 end
                    return cur, ux, uy
                end
                local function atCellCenter()
                    local cx, cy = math.floor(mx / C) + 1, math.floor(my / C) + 1
                    return math.abs(mx - (cx - 0.5) * C) < 1.3 and math.abs(my - (cy - 0.5) * C) < 1.3
                end

                local function pickPatrolTarget()
                    local cx, cy = math.floor(mx / C) + 1, math.floor(my / C) + 1
                    local dm = bfs3(mf, cx, cy)
                    local list = {}
                    for _, n in ipairs(allNodes) do
                        local d = dm[n[1]][n[3]][n[2]]
                        if d and d >= 8 and d <= 36 then list[#list + 1] = n end
                    end
                    local n = list[math.random(#list)] or allNodes[math.random(#allNodes)]
                    goMap = bfs3(n[1], n[2], n[3])
                end
                local function pickSearchNode()
                    local list = {}
                    for _, n in ipairs(allNodes) do
                        local d = searchMap[n[1]][n[3]][n[2]]
                        if d and d >= 2 and d <= 11 then list[#list + 1] = n end
                    end
                    local n = list[math.random(#list)]
                    if n then goMap = bfs3(n[1], n[2], n[3]) else goMap = searchMap end
                end

                local function onSpotted()
                    if (FL.rageCool or 0) <= 0 then
                        FL.rage = SP.hard and 0.9 or 1.6      -- كم ثانية يوقف ويعصب
                        FL.rageCool = SP.hard and 6 or 8    -- أقل فترة بين عصبة وعصبة
                    end
                    seenNow = true
                    eyePop = 1
                    spotPulse = 1
                    camKick = math.max(camKick, 0.75)
                    camKickRoll = math.max(camKickRoll, 0.055)
                    playHorrorSFX("Rage", 1.15, rnd(0.94, 1.04), 1.2)
                    chaseMap, chaseTimer = nil, 0
                    hint.Text = "الوحش شافك! 👁️ اهرب واختفي عن نظره"
                    hint.Visible = true
                    hintTimer = 2.5
                end
                local function onLost()
                    FL.rage = 0
                    seenNow = false
                    hint.Text = "ضيّعته 🔍 بس هو يدور عليك، لا تطلع قدامه"
                    hint.Visible = true
                    hintTimer = 2.5
                end
                local function toPatrol()
                    mState = "patrol"
                    goMap = nil
                    waitTimer = 0.4
                end

                -- 🚪🩸 الاختباء بالدولاب + الهلث
                -- • تقدر تختبئ حتى لو الوحش شايفك، بس هو يجي يوقف قدام الدولاب ويفتحه ويذبحك
                -- • لو اختبأت بدون ما يشوفك: تقدر تقعد شوي، وإذا طولت تبدأ تهلوس وتتنفس بصوت عالي ويقل الهلث لين تموت
                H.SAFE = SP.hard and 8 or 12        -- كم ثانية تقدر تقعد بالدولاب قبل الهلوسة
                H.HITDMG = SP.hard and 34 or 25     -- ضرر ضربة الوحش (من 100)
                H.sm = function(x) x = math.clamp(x, 0, 1) return x * x * (3 - 2 * x) end

                function H.setDoors(h, th)
                    if not h or not h.doors then return end
                    for sgn, d in pairs(h.doors) do
                        local rot = h.b * CFrame.new(d.hx, 0, d.zf) * CFrame.Angles(0, -sgn * th, 0) * CFrame.new(-d.hx, 0, -d.zf)
                        for _, e in ipairs(d.list) do e.p.CFrame = rot * e.rel end
                    end
                end

                -- 💀 موت بدون وحش (اختناق داخل الدولاب)
                function H.die(why)
                    if state ~= "play" or adminInvincible then return end
                    H.hs.dying = why
                    state = "caught"
                    endTimer = 0
                    caughtSFXFinished = true
                    caughtSFXFallback = 0
                    moveVec = Vector2.new(0, 0)
                    knob.Position = UDim2.new(0.5, 0, 0.5, 0)
                    pcall(function() if _G.SkyGameAudio then _G.SkyGameAudio.End("horror") end end)
                end
                -- 🩸 ضرر: الشاشة تحمر خفيف وتروح على طول
                function H.hurt(dmg, why)
                    local hs = H.hs
                    if state ~= "play" or adminInvincible then return end
                    hs.hp = math.max(0, hs.hp - dmg)
                    hs.hurtA = 1
                    hs.regenCd = 0
                    camKick = math.max(camKick, 0.5)
                    camKickRoll = math.max(camKickRoll, 0.03)
                    if hs.hp <= 0 then
                        if why == "hide" then H.die("hide") else triggerCaught() end
                    else
                        playHorrorSFX("Caught", 0.55, 1.5, 0.2)
                    end
                end
                -- 👹 ضربة الوحش (ما يذبحك من أول ضربة)
                function H.monsterHit()
                    local hs = H.hs
                    if hs.atkCd > 0 or hs.on then return end
                    hs.atkCd = 1.25
                    hs.stagger = 0.9
                    H.hurt(H.HITDMG, "monster")
                end

                function H.hsAnimDone(a)
                    local hs = H.hs
                    hs.anim = nil
                    H.setDoors(a.h, 0)
                    px, py, yaw = a.x1, a.y1, a.yaw1
                    if a.kind == "in" then
                        hs.slats.Visible = true
                        hs.btn.Text = "🚪 اطلع"
                        playHorrorSFX("FlashOff", 0.5, 0.5, 0)
                        hint.Text = hs.found and "اختبأت... بس هو شافك! 😱" or "اختبأت 🤫 لا تطول داخل الدولاب"
                        hint.Visible = true
                        hintTimer = 3
                    else
                        hs.on, hs.cur, hs.found, hs.opening = false, nil, false, nil
                        hs.stay = 0
                        hs.cool = 2.5
                        hs.btn.Text = "🚪 اختبئ"
                        playHorrorSFX("FlashOn", 0.4, 0.6, 0)
                    end
                end
                function H.hideEnter()
                    local hs = H.hs
                    local h = hs.near
                    if hs.on or hs.anim or not h or state ~= "play" then return end
                    if hs.cool > 0 then
                        hint.Text = "استنى شوي قبل ما تختبئ ثانية ⏳"
                        hint.Visible = true
                        hintTimer = 1.5
                        return
                    end
                    hs.found = (seenNow or mState == "chase") -- لو شايفك وانت تختبئ: بيجي ويفتح الدولاب
                    hs.on, hs.cur, hs.opening, hs.stay, hs.tick, hs.chk = true, h, nil, 0, 1, 1.2
                    moveVec = Vector2.new(0, 0)
                    knob.Position = UDim2.new(0.5, 0, 0.5, 0)
                    SP.on, SP.tog = false, false
                    hs.anim = {kind = "in", t = 0, dur = 1.0, h = h, x0 = px, y0 = py, yaw0 = yaw, x1 = h.px, y1 = h.pz, yaw1 = h.yaw}
                    playHorrorSFX("FlashOff", 0.5, 0.6, 0.2)
                end
                function H.hideExit()
                    local hs = H.hs
                    if not hs.on or hs.anim or hs.opening or state ~= "play" then return end
                    local h = hs.cur
                    hs.slats.Visible = false
                    hs.anim = {kind = "out", t = 0, dur = 0.9, h = h, x0 = px, y0 = py, yaw0 = yaw, x1 = h.ex, y1 = h.ez, yaw1 = h.yaw}
                    playHorrorSFX("FlashOn", 0.4, 0.6, 0.2)
                end
                H.hs.btn.Activated:Connect(function()
                    if state ~= "play" then return end
                    if H.hs.on then H.hideExit() else H.hideEnter() end
                end)

                -- كل فريم: أنيميشن الدخول/الطلوع، الهلوسة، التنفس، الهلث، الشاشة الحمراء
                function H.hsFrame(dt)
                    local hs = H.hs
                    local clk = os.clock()
                    hs.atkCd = math.max(0, hs.atkCd - dt)
                    hs.stagger = math.max(0, hs.stagger - dt)
                    hs.cool = math.max(0, hs.cool - dt)
                    hs.regenCd = hs.regenCd + dt
                    if state == "play" then
                        local a = hs.anim
                        if a then
                            -- 🎬 الدولاب ينفتح، تدخل (أو تطلع)، وينسكر
                            a.t = a.t + dt
                            local u = math.clamp(a.t / a.dur, 0, 1)
                            local sm = H.sm
                            H.setDoors(a.h, 1.9 * (sm(u / 0.3) - sm((u - 0.65) / 0.35)))
                            local mv = sm((u - 0.2) / 0.5)
                            px, py = a.x0 + (a.x1 - a.x0) * mv, a.y0 + (a.y1 - a.y0) * mv
                            local dy = (a.yaw1 - a.yaw0 + math.pi) % (2 * math.pi) - math.pi
                            yaw = a.yaw0 + dy * sm(u / 0.6)
                            pitch, turnRemain = 0, 0
                            if u >= 1 then H.hsAnimDone(a) end
                        elseif hs.on and hs.cur then
                            px, py, yaw, pitch, turnRemain = hs.cur.px, hs.cur.pz, hs.cur.yaw, 0, 0
                        end

                        -- ⏳ طولت بالدولاب: هلوسة + تنفس عالي + ضرر كل ثانية يزيد
                        if hs.on and not hs.anim and not hs.found and not hs.opening then
                            local before = hs.stay
                            hs.stay = hs.stay + dt
                            hs.halu = math.clamp((hs.stay - H.SAFE) / 6, 0, 1)
                            if before <= H.SAFE - 3 and hs.stay > H.SAFE - 3 then
                                hint.Text = "نفسك يضيق... لا تطول داخل الدولاب 😰"
                                hint.Visible = true
                                hintTimer = 3
                            end
                            if hs.halu > 0 then
                                hs.tick = hs.tick - dt
                                if hs.tick <= 0 then
                                    hs.tick = 1
                                    H.hurt(3 + 9 * hs.halu, "hide")
                                end
                            end
                        else
                            hs.halu = math.max(0, hs.halu - dt / 3)
                        end

                        -- 👹 الوحش يدوّر قريب منك: ممكن يلقى الدولاب (التنفس العالي يفضحك أكثر)
                        if hs.on and hs.cur and not hs.found and not hs.anim and mf == hs.cur.f then
                            local ddx, ddz = mx - hs.cur.ex, my - hs.cur.ez
                            local rad = (1.5 + 2.5 * hs.halu) * C
                            if ddx * ddx + ddz * ddz < rad * rad and mState ~= "patrol" then
                                hs.chk = hs.chk - dt
                                if hs.chk <= 0 then
                                    hs.chk = 2.2
                                    if math.random() < 0.4 + 0.35 * hs.halu then hs.found = true end
                                end
                            else
                                hs.chk = 1.2
                            end
                        end

                        -- 🚪💀 الوحش وصل قدام الدولاب: يفتحه ويذبحك
                        if hs.on and hs.found and hs.opening and hs.cur then
                            hs.opening = hs.opening + dt
                            H.setDoors(hs.cur, 2.1 * H.sm(hs.opening / 0.45))
                            if hs.opening >= 1.1 then
                                hs.on, hs.cur, hs.found, hs.opening = false, nil, false, nil
                                triggerCaught()
                            end
                        end

                        -- ❤️ الهلث يرجع شوي شوي بعيد عن الخطر
                        if hs.hp < 100 and hs.regenCd > 8 and not seenNow and not hs.on then
                            hs.hp = math.min(100, hs.hp + 2.5 * dt)
                        end
                    else
                        hs.halu = math.max(0, hs.halu - dt / 1.5)
                    end

                    -- 😮 تنفس + نبض قلب
                    local I = hs.halu
                    if state == "play" and hs.on and not hs.found and not hs.anim then
                        I = math.max(I, math.clamp((hs.stay - (H.SAFE - 3)) / 3, 0, 1) * 0.2)
                    end
                    local function setLoop(snd, want, vol, spd)
                        if not snd then return end
                        if want then
                            snd.Volume, snd.PlaybackSpeed = vol, spd
                            if not snd.IsPlaying then snd:Play() end
                        elseif snd.IsPlaying then
                            snd:Stop()
                        end
                    end
                    setLoop(HorrorSFX.Breath, state == "play" and I > 0.01, 0.5 + 4.5 * I, 0.95 + 0.35 * I)
                    setLoop(HorrorSFX.Heart, state == "play" and I > 0.12, 0.4 + 2.2 * I, 0.9 + 0.6 * I)

                    -- 🌀 مؤثرات الهلوسة
                    local hv = hs.halu
                    hs.haluF.BackgroundTransparency = 1 - 0.3 * hv * (0.55 + 0.45 * math.sin(clk * 4.5))
                    if hv > 0.15 and state == "play" then
                        hs.haluT = hs.haluT - dt
                        if hs.haluT <= 0 then
                            hs.haluT = 0.9 + math.random() * 1.2
                            local msgs = {"هو هنا...", "يشوفك", "اطلع!", "👁️", "اسمع خطواته", "ما في مكان تهرب"}
                            hs.haluTxt.Text = msgs[math.random(#msgs)]
                            hs.haluTxt.Position = UDim2.new(0.15 + math.random() * 0.7, 0, 0.2 + math.random() * 0.6, 0)
                            hs.haluTxt.Rotation = math.random(-12, 12)
                            hs.haluTxt.TextTransparency = 0.2
                            hs.haluTxt.Visible = true
                        else
                            hs.haluTxt.TextTransparency = math.min(1, hs.haluTxt.TextTransparency + dt * 1.1)
                        end
                    else
                        hs.haluTxt.Visible = false
                    end

                    -- 🩸 الشاشة الحمراء الخفيفة + شريط الهلث
                    hs.hurtA = math.max(0, hs.hurtA - dt * 3.2)
                    local lowP = (state == "play" and hs.hp < 30) and (0.07 + 0.05 * math.sin(clk * 5)) or 0
                    hs.hurtF.BackgroundTransparency = 1 - math.min(0.5, 0.3 * hs.hurtA + lowP)
                    local k = math.clamp(hs.hp / 100, 0, 1)
                    hs.hpFill.Size = UDim2.new(k, 0, 1, 0)
                    hs.hpFill.BackgroundColor3 = Color3.fromRGB(math.floor(220 - 150 * k), math.floor(40 + 160 * k), 60)
                end

                local function aiStep(dt)
                    if adminMonsterBlind then
                        sightAudio.active = false
                        sightAudio.elapsed = 0
                        sightAudio.lost = 0
                        sightAudio.token = sightAudio.token + 1
                        pcall(function() sightAudio.short:Stop(); sightAudio.long:Stop(); sightAudio.long.Volume = 0 end)
                        for _, voice in ipairs(ambientMonsterAudio.sounds) do
                            pcall(function() voice:Stop() end)
                        end
                        mState = "patrol"
                        goMap = nil
                        seenNow = false
                        FL.rage = 0
                        chaseMap, chaseTimer = nil, 0
                        return
                    end
                    FL.rageCool = math.max(0, (FL.rageCool or 0) - dt)
                    -- 🚪 اختبأت وهو شايفك (أو لقى دولابك): يجي قدام الدولاب، يفتحه ويذبحك
                    do
                        local hs = H.hs
                        if hs.on and hs.found and hs.cur and state == "play" then
                            local h = hs.cur
                            mState = "chase"
                            seenNow = true
                            local speed = PSPEED * (SP.hard and (1.0 + keysCollected * 0.06) or (0.55 + keysCollected * 0.05))
                            if not hs.opening then
                                local dd = math.sqrt((mx - h.ex) ^ 2 + (my - h.ez) ^ 2)
                                if mf == h.f and dd < 0.3 * C and not hs.anim then
                                    hs.opening = 0
                                    hs.slats.Visible = false
                                    playHorrorSFX("Rage", 1.2, 0.9, 0)
                                    camKick = math.max(camKick, 0.8)
                                    camKickRoll = math.max(camKickRoll, 0.05)
                                elseif mf == h.f and clearLine(mf, mx, my, h.ex, h.ez) then
                                    monsterMoveTo(h.ex, h.ez, speed, dt)
                                    faceToward(h.ex - mx, h.ez - my, dt, 9)
                                else
                                    chaseTimer = chaseTimer - dt
                                    if chaseTimer <= 0 or not chaseMap then
                                        chaseTimer = 0.2
                                        chaseMap = bfs3(h.f, h.x, h.y)
                                    end
                                    navStep(chaseMap, dt, speed, h.ex, h.ez)
                                    faceToward(h.ex - mx, h.ez - my, dt, 9)
                                end
                            else
                                faceToward(-h.nx, -h.ny, dt, 12)
                            end
                            return
                        end
                    end
                    local see = canSeePlayer()
                    updateSightAudio(see, dt)
                    ambientMonsterAudio.update(see, dt)
                    local pcx, pcy = math.floor(px / C) + 1, math.floor(py / C) + 1
                    if see then
                        lastSeen = {pf, pcx, pcy}
                        if mState ~= "chase" then
                            mState = "chase"
                            onSpotted()
                        end
                    elseif mState == "chase" then
                        -- طلعت من مجال رؤيته: يروح لآخر مكان شافك فيه ويدور
                        mState = "search"
                        searchTimer = SEARCH_TIME
                        searchPhase = "goto"
                        lookTimer = 0
                        searchMap = bfs3(lastSeen[1], lastSeen[2], lastSeen[3])
                        goMap = searchMap
                        onLost()
                    end

                    if mState == "chase" then
                        -- يلحقك بس: لو يشوفك مباشرة يمشي عليك، ولو في جدار بينكم يمشي بالطريق
                        local speed = PSPEED * (SP.hard and (1.0 + keysCollected * 0.06) or (0.55 + keysCollected * 0.05))
                        if (FL.rage or 0) > 0 then
                            -- شافك: يوقف ويعصب (يطالع فيك وما يتحرك)
                            FL.rage = FL.rage - dt
                            faceToward(px - mx, py - my, dt, 10)
                        else
                            if mf == pf and clearLine(mf, mx, my, px, py) then
                                monsterMoveTo(px, py, speed, dt)
                                chaseMap = nil
                            else
                                chaseTimer = chaseTimer - dt
                                if chaseTimer <= 0 or not chaseMap then
                                    chaseTimer = 0.2
                                    chaseMap = bfs3(pf, pcx, pcy)
                                end
                                navStep(chaseMap, dt, speed, px, py)
                            end
                            faceToward(px - mx, py - my, dt, 9)
                        end
                    elseif mState == "search" then
                        searchTimer = searchTimer - dt
                        if searchTimer <= 0 then
                            toPatrol()
                        elseif searchPhase == "goto" then
                            local cur, ux, uy = navStep(goMap, dt, PSPEED * SEARCH_SPEED)
                            faceToward(ux, uy, dt, 7)
                            if cur == 0 and atCellCenter() then
                                searchPhase = "look"
                                lookTimer = rnd(1.6, 3)
                                lookDir = (math.random() < 0.5) and 1 or -1
                            end
                        else
                            lookTimer = lookTimer - dt
                            -- يلف حواليه يدور عليك
                            local a = dt * 1.9 * lookDir
                            local c, s = math.cos(a), math.sin(a)
                            local fx, fz = mFace.X * c - mFace.Z * s, mFace.X * s + mFace.Z * c
                            mFace = Vector3.new(fx, 0, fz)
                            if lookTimer <= 0 then
                                pickSearchNode()
                                searchPhase = "goto"
                            end
                        end
                    else
                        if waitTimer > 0 then
                            waitTimer = waitTimer - dt
                            local a = dt * 0.9
                            local c, s = math.cos(a), math.sin(a)
                            mFace = Vector3.new(mFace.X * c - mFace.Z * s, 0, mFace.X * s + mFace.Z * c)
                        else
                            if not goMap then pickPatrolTarget() end
                            local cur, ux, uy = navStep(goMap, dt, PSPEED * PATROL_SPEED)
                            faceToward(ux, uy, dt, 5)
                            if cur == 0 and atCellCenter() then
                                goMap = nil
                                waitTimer = rnd(0.8, 2.4)
                            end
                        end
                    end
                end

                -- 🔑 استلام مفتاح (من الخريطة أو من اللغز)
                local function gainKey(x, z, f)
                    keysCollected = keysCollected + 1
                    keysHud.Text = "🔑 " .. keysCollected .. "/" .. TOTAL_KEYS
                    ringFx(x, z, Color3.fromRGB(255, 215, 80), f)
                    playKeySFX()
                    camKick = math.max(camKick, 0.18)
                    globalFlicker = math.max(globalFlicker, 1.3)
                    if keysCollected >= TOTAL_KEYS then
                        hint.Text = "انفتح الباب! اهرب له 🚪 (الباب الخارجي بالدور الأرضي)"
                        hintTimer = 4
                    else
                        hint.Text = "الوحش صار أسرع 👹"
                        hintTimer = 2.5
                    end
                    hint.Visible = true
                end

                -- 🔦 الكشاف: يشتغل ويطفي، البطارية تنزل، ولما تقرب تخلص يرمش أسرع وأسرع لين يطفي
                local flashWant = true
                function FL.toggle()
                    if state ~= "play" then return end
                    if FL.bat <= 0 then
                        hint.Text = "🔋 البطارية خلصت! دور على بطارية بالبيت"
                        hint.Visible = true
                        hintTimer = 2
                        return
                    end
                    flashWant = not flashWant
                    if flashWant then
                        playHorrorSFX("FlashOn", 0.65, 1.0, 0.15)
                    else
                        playHorrorSFX("FlashOff", 0.55, 1.0, 0.15)
                    end
                end
                -- 🎒 استخدام بطارية من الشنطة
                function FL.useBat(i)
                    if state ~= "play" then return end
                    local bt = FL.bag and FL.bag[i]
                    if not bt then return end
                    if FL.bat >= 99.5 and not FL.dead then
                        hint.Text = "🔋 الكشاف ممتلئ، استخدمها بعدين"
                        hint.Visible = true
                        hintTimer = 2
                        return
                    end
                    table.remove(FL.bag, i)
                    FL.bat = math.min(100, FL.bat + 45)
                    if FL.dead then
                        FL.dead = false
                        flashWant = true
                    end
                    hint.Text = "🔋 غيّرت البطارية! الكشاف رجع يشتغل"
                    hint.Visible = true
                    hintTimer = 2.5
                    if FL.refreshBag then FL.refreshBag() end
                end
                -- 🗑️ رمي بطارية من الشنطة (تنزل على الأرض مكانك، وتقدر تلقطها ثانية لو رجعت لها)
                function FL.throwBat(i)
                    if state ~= "play" then return end
                    local bt = FL.bag and FL.bag[i]
                    if not bt then return end
                    table.remove(FL.bag, i)
                    bt.x, bt.z, bt.f = px, py, pf
                    bt.taken = false
                    bt.shown = false
                    bt.dropped = true -- ما تنلقط تلقائي لين تبعد عنها
                    hint.Text = "🗑️ رميت البطارية"
                    hint.Visible = true
                    hintTimer = 2
                    if FL.refreshBag then FL.refreshBag() end
                end
                local function updateFlash(dt)
                    local want = flashWant and FL.bat > 0
                    if want then
                        FL.bat = FL.bat - dt * (100 / 150)
                        if FL.bat <= 0 then
                            FL.bat = 0
                            want = false
                            flashWant = false
                            FL.dead = true
                            playHorrorSFX("FlashOff", 0.55, 0.92, 0.25)
                            hint.Text = "🔋 البطارية خلصت! دور على بطارية بالبيت"
                            hint.Visible = true
                            hintTimer = 3
                        end
                    end
                    local I = 0
                    if want then
                        I = 1
                        if FL.bat <= 25 then
                            local k = FL.bat / 25 -- 1 -> 0
                            FL.flickT = FL.flickT - dt
                            if FL.flickT <= 0 then
                                FL.flickOn = not FL.flickOn
                                if FL.flickOn then FL.flickT = rnd(0.5, 1.2) * (0.1 + 1.9 * k * k)
                                else FL.flickT = rnd(0.5, 1) * (0.04 + 0.16 * (1 - k)) end
                            end
                            if not FL.flickOn then I = 0.04 end
                        else
                            FL.flickOn = true
                            FL.flickT = 0
                        end
                    end
                    if I ~= FL.I then
                        FL.I = I
                        relightTimer = 0
                    end
                    FL.on = want
                    -- شكل الزر والشريط
                    local frac = FL.bat / 100
                    PZ.batFill.Size = UDim2.new(math.max(frac, 0.001) * (1 - 4 / 104), 0, 1, -4)
                    PZ.batFill.BackgroundColor3 = (frac > 0.5) and Color3.fromRGB(80, 230, 110)
                        or (frac > 0.25) and Color3.fromRGB(240, 205, 70) or Color3.fromRGB(240, 70, 60)
                    if frac <= 0.25 and frac > 0 then
                        PZ.batFill.BackgroundTransparency = (math.floor(os.clock() * 5) % 2 == 0) and 0 or 0.5
                    else
                        PZ.batFill.BackgroundTransparency = 0
                    end
                    PZ.batTxt.Text = math.ceil(FL.bat) .. "%"
                    PZ.flashBtn.BackgroundColor3 = want and Color3.fromRGB(110, 96, 28) or Color3.fromRGB(30, 30, 34)
                    PZ.flashBtn.Text = want and "🔦" or "⚫"
                    PZ.batStroke.Color = want and Color3.fromRGB(255, 220, 90) or Color3.fromRGB(110, 110, 110)
                end

                -- 🕰️ اللغز: الرقم الصح يفتح الدولاب ويعطيك مفتاح
                function PZ.submit(code)
                    if PZ.solved then return true end
                    if code ~= H.code then return false end
                    PZ.solved = true
                    PZ.near = false
                    PZ.enterBtn.Visible = false
                    CAB.open()
                    gainKey(CAB.x, CAB.z, 0)
                    hint.Text = "🗝️ انفتح الدولاب وطلع مفتاح! 🔑"
                    hint.Visible = true
                    hintTimer = 4
                    return true
                end

                -- 🎨 لغز الألوان انحل: المفتاح
                function CP.onSolved()
                    CP.near = false
                    CP.enterBtn.Visible = false
                    gainKey(CP.x, CP.z, CP.f)
                    hint.Text = "🎨 انحل لغز الألوان وطلع مفتاح! 🔑"
                    hint.Visible = true
                    hintTimer = 4
                end

                local function step(dt)
                    if PZ.open then return end -- اللعبة تتوقف وانت تكتب الأرقام
                    t = t + dt

                    -- ⌨️ الحركة (عصا الجوال أو WASD)، الالتفات: السحب أو Q/E أو الأسهم
                    if state == "play" then
                        local vx, vy = moveVec.X, moveVec.Y
                        if not UserInputService:GetFocusedTextBox() then
                            if vx == 0 and vy == 0 then
                                if UserInputService:IsKeyDown(Enum.KeyCode.D) then vx = vx + 1 end
                                if UserInputService:IsKeyDown(Enum.KeyCode.A) then vx = vx - 1 end
                                if UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.Down) then vy = vy + 1 end
                                if UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.Up) then vy = vy - 1 end
                            end
                            if UserInputService:IsKeyDown(Enum.KeyCode.Q) or UserInputService:IsKeyDown(Enum.KeyCode.Left) then yaw = yaw + 2.2 * dt end
                            if UserInputService:IsKeyDown(Enum.KeyCode.E) or UserInputService:IsKeyDown(Enum.KeyCode.Right) then yaw = yaw - 2.2 * dt end
                        end
                        if turnRemain > 0 then
                            local st = math.min(turnRemain, dt * 12)
                            yaw = yaw + st
                            turnRemain = turnRemain - st
                        end
                        if H.hs.on then vx, vy = 0, 0 end -- 🚪 ما تتحرك وانت بالدولاب
                    local mag = math.sqrt(vx * vx + vy * vy)
                        if mag > 1 then vx, vy = vx / mag, vy / mag; mag = 1 end
                        local sn, cs = math.sin(yaw), math.cos(yaw)
                        local dx = cs * vx + sn * vy
                        local dz = -sn * vx + cs * vy
                        -- 🏃 الركض (الصعب فقط): Shift بالكيبورد أو زر 🏃 بالجوال، وله طاقة تخلص وترجع
                        local spm = 1
                        if SP.hard then
                            local shiftDown = not UserInputService:GetFocusedTextBox()
                                and (UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift))
                            local wantRun = (SP.tog or shiftDown) and mag > 0.2
                            if SP.tired and SP.stam >= 25 then SP.tired = false end
                            if wantRun and not SP.tired and SP.stam > 0 then
                                spm = SP.mul
                                SP.on = true
                                SP.stam = math.max(0, SP.stam - SP.drain * dt)
                                if SP.stam <= 0 then SP.tired, SP.tog = true, false end
                            else
                                SP.on = false
                                SP.stam = math.min(100, SP.stam + ((mag > 0.2) and 9 or 16) * dt)
                            end
                            if SP.ui then SP.ui() end
                        end
                        local nx = px + dx * PSPEED * spm * dt
                        if not blocked(nx, py) then px = nx end
                        local nz = py + dz * PSPEED * spm * dt
                        if not blocked(px, nz) then py = nz end
                        walkAmt = walkAmt + (mag - walkAmt) * math.min(1, dt * 8)
                        walkPhase = walkPhase + dt * 9 * mag * (1 + (spm - 1) * 0.9)
                        -- 👣 خطوة كلما تحرك اللاعب، مع تسارع بسيط عند الجري
                        if mag > 0.12 then
                            -- نشغل نفس صوت الخطوات كحلقة؛ لا نعيده من البداية مع كل نبضة حركة.
                            local foot = HorrorSFX.Footstep
                            if foot and not foot.IsPlaying then foot:Play() end
                            if foot then
                                foot.Volume = (0.32 + 0.12 * mag) * (spm > 1 and 1.5 or 1)
                                foot.PlaybackSpeed = (0.96 + 0.08 * mag) * (spm > 1 and 1.35 or 1)
                            end
                            footstepTimer = 0
                            -- حركة الكاميرا أصبحت موجية وناعمة؛ لا نضيف اهتزازًا عشوائيًا مع كل خطوة.
                        else
                            footstepTimer = 0
                            if HorrorSFX.Footstep and HorrorSFX.Footstep.IsPlaying then
                                HorrorSFX.Footstep:Stop()
                            end
                        end
                    elseif state == "caught" then
                        sightAudio.active = false
                        sightAudio.elapsed = 0
                        sightAudio.lost = 0
                        sightAudio.token = sightAudio.token + 1
                        pcall(function() sightAudio.short:Stop() end)
                        if sightAudio.tween then sightAudio.tween:Cancel() end
                        pcall(function() sightAudio.long:Stop(); sightAudio.long.Volume = 0 end)
                        if HorrorSFX.Footstep and HorrorSFX.Footstep.IsPlaying then
                            HorrorSFX.Footstep:Stop()
                        end
                        local ang = math.atan2(-(mx - px), -(my - py))
                        local diff = ((ang - yaw + math.pi) % (2 * math.pi)) - math.pi
                        yaw = yaw + diff * math.min(1, dt * 10)
                        pitch = pitch + (0.85 - pitch) * math.min(1, dt * 5)
                        walkAmt = walkAmt * 0.9
                    else
                        walkAmt = walkAmt * 0.9
                    end
                    H.hsFrame(dt)
                    fwdX, fwdZ = -math.sin(yaw), -math.cos(yaw)

                    -- 🪜 الانتقال بين الدورين + ارتفاع الأرض تحت رجلك
                    do
                        local ccx, ccy = math.floor(px / C) + 1, math.floor(py / C) + 1
                        if pf == 0 and ccx == Ex and ccy == Ey then pf = 1
                        elseif pf == 1 and ccx == Cx and ccy == Cy then pf = 0 end
                        pElev = elevAt(pf, px, py)
                        viewElev = viewElev + (pElev - viewElev) * math.min(1, dt * 10)
                        updateVis(false)
                    end

                    -- 👤 الوحش (يتجول / يلحقك لو شافك / يدور لو ضيّعك)
                    if state == "play" then
                        startTimer = startTimer - dt
                        if startTimer <= 0 then aiStep(dt) end
                    elseif state == "caught" then
                        mf = pf
                        local ddx, ddz = mx - px, my - py
                        local dl = math.sqrt(ddx * ddx + ddz * ddz)
                        if dl > 0.01 then
                            local tx, tz = px + ddx / dl * 4.2, py + ddz / dl * 4.2
                            mx = mx + (tx - mx) * math.min(1, dt * 12)
                            my = my + (tz - my) * math.min(1, dt * 12)
                        end
                        faceToward(px - mx, py - my, dt, 12)
                    end
                    mElev = elevAt(mf, mx, my)
                    local sameLevel = math.abs(mElev - pElev) < 9
                    local md = math.sqrt((mx - px) ^ 2 + (my - py) ^ 2) / C + (sameLevel and 0 or 8)

                    -- 👣 خطوات الوحش: القوة حسب القرب، والصوت يجي من اليمين أو اليسار حسب مكانه
                    pcall(function()
                        local cam = workspace.CurrentCamera
                        if not cam then return end
                        if not MonStep.snd then
                            local part = Instance.new("Part")
                            part.Name = "SkyMonsterStepEmitter"
                            part.Anchored, part.CanCollide, part.CanQuery, part.CanTouch = true, false, false, false
                            part.Transparency = 1
                            part.Size = Vector3.new(1, 1, 1)
                            part.Parent = cam
                            local snd = Instance.new("Sound")
                            snd.Name = "MonsterFootsteps"
                            snd.SoundId = "rbxassetid://1244506786"
                            snd.Looped = true
                            snd.Volume = 0
                            snd.PlaybackSpeed = 0.62
                            snd.RollOffMode = Enum.RollOffMode.Linear
                            snd.RollOffMinDistance = 200 -- بدون تلاشي بالمسافة (نتحكم بالقوة بنفسنا)
                            snd.RollOffMaxDistance = 400
                            snd.Parent = part
                            if SP.hard then
                                -- 🔊 تضخيم الجهير + صدى عشان الخطوات تحس فيها ثقل ورهبة
                                pcall(function()
                                    local eq = Instance.new("EqualizerSoundEffect")
                                    eq.LowGain, eq.MidGain, eq.HighGain = 10, -3, -12
                                    eq.Parent = snd
                                    local rv = Instance.new("ReverbSoundEffect")
                                    rv.DecayTime, rv.Density, rv.Diffusion = 2.2, 0.8, 0.8
                                    rv.DryLevel, rv.WetLevel = 0, -6
                                    rv.Parent = snd
                                end)
                            end
                            MonStep.part, MonStep.snd = part, snd
                            MonStep.lx, MonStep.ly = mx, my
                        end
                        -- هل الوحش يتحرك؟
                        local moved = math.sqrt((mx - MonStep.lx) ^ 2 + (my - MonStep.ly) ^ 2) / math.max(dt, 1e-3)
                        MonStep.lx, MonStep.ly = mx, my
                        MonStep.mv = MonStep.mv + ((moved > 2.5 and 1 or 0) - MonStep.mv) * math.min(1, dt * 8)
                        local target = 0
                        if state == "play" and md < MonStep.range then
                            target = math.clamp(1 - md / MonStep.range, 0, 1) ^ 1.2 * MonStep.maxvol * MonStep.mv
                        end
                        MonStep.vol = MonStep.vol + (target - MonStep.vol) * math.min(1, dt * 6)
                        local snd = MonStep.snd
                        snd.Volume = math.min(MonStep.vol, 10)
                        snd.PlaybackSpeed = (mState == "chase") and MonStep.rateChase or MonStep.rateWalk
                        -- 💥 كل خطوة ثقيلة تهز الكاميرا لما يقرب الوحش (الصعب فقط)
                        if SP.hard and state == "play" and MonStep.mv > 0.5 and md < 12 then
                            MonStep.thudT = MonStep.thudT - dt
                            if MonStep.thudT <= 0 then
                                MonStep.thudT = (mState == "chase") and 0.3 or 0.62
                                local nearK = math.clamp(1 - md / 12, 0, 1)
                                camKick = math.max(camKick, 0.08 + 0.45 * nearK)
                                camKickRoll = math.max(camKickRoll, 0.012 * nearK)
                            end
                        end
                        if MonStep.vol > 0.02 then
                            if not snd.IsPlaying then snd:Play() end
                        elseif snd.IsPlaying then
                            snd:Stop()
                        end
                        -- اتجاه الصوت: مكان الوحش بالنسبة لاتجاه نظرك (يمين/يسار/قدام/ورا)
                        local dx, dz = mx - px, my - py
                        local right = dx * math.cos(yaw) - dz * math.sin(yaw)
                        local fwd = -dx * math.sin(yaw) - dz * math.cos(yaw)
                        local dir = Vector3.new(right, 0, -fwd)
                        if dir.Magnitude < 1e-3 then dir = Vector3.new(0, 0, -1) end
                        MonStep.part.Position = cam.CFrame.Position + cam.CFrame:VectorToWorldSpace(dir.Unit * 6)
                    end)

                    -- 🔑 المفاتيح
                    if state == "play" then
                        for _, k in ipairs(keyList) do
                            if not k.taken then
                                local kd = math.sqrt((k.x - px) ^ 2 + (k.z - py) ^ 2)
                                local lvl = math.abs(k.f * FH - pElev) < FH * 0.9
                                local show = lvl and kd < 6.5 * C
                                if show ~= k.shown then
                                    k.shown = show
                                    k.model.Parent = show and scene or nil
                                end
                                if lvl and math.abs(k.f * FH - pElev) < 6 and kd < 0.55 * C then
                                    k.taken = true
                                    k.model.Parent = nil
                                    gainKey(k.x, k.z, k.f)
                                end
                            end
                        end
                    end
                    for _, k in ipairs(keyList) do
                        if k.shown and not k.taken then
                            k.model:PivotTo(CFrame.new(k.x, k.f * FH + 3.8 + math.sin(t * 2.4 + k.x) * 0.5, k.z) * CFrame.Angles(0, t * 2 + k.x, 0))
                        end
                    end

                    -- 🔋 البطاريات
                    for _, bt in ipairs(batList) do
                        if not bt.taken then
                            local bd = math.sqrt((bt.x - px) ^ 2 + (bt.z - py) ^ 2)
                            local lvl = math.abs(bt.f * FH - pElev) < FH * 0.9
                            local show = lvl and bd < 6.5 * C
                            if show ~= bt.shown then
                                bt.shown = show
                                bt.model.Parent = show and scene or nil
                            end
                            if show then
                                bt.model:PivotTo(CFrame.new(bt.x, bt.f * FH + 2.8 + math.sin(t * 2.6 + bt.x) * 0.45, bt.z) * CFrame.Angles(0, t * 2 + bt.x, 0) * FLAT)
                            end
                            if bt.dropped then
                                if bd > 1.2 * C then bt.dropped = false end
                            elseif state == "play" and lvl and math.abs(bt.f * FH - pElev) < 6 and bd < 0.55 * C then
                                bt.taken = true
                                bt.model.Parent = nil
                                FL.bag[#FL.bag + 1] = bt
                                ringFx(bt.x, bt.z, Color3.fromRGB(110, 255, 140), bt.f)
                                playHorrorSFX("Battery", 0.55, rnd(1.02, 1.08), 0.18)
                                camKick = math.max(camKick, 0.16)
                                hint.Text = "🔋 لقيت بطارية! انحطت بالشنطة 🎒 (B)"
                                hint.Visible = true
                                hintTimer = 2.5
                                if FL.refreshBag then FL.refreshBag() end
                            end
                        end
                    end
                    updateFlash(dt)

                    -- 🚪 الأبواب تنفتح لما تقرب منها (أنت أو الوحش)
                    for _, d in ipairs(doors) do
                        local near = false
                        if math.abs(d.f * FH - pElev) < FH * 0.9 then
                            local ddx, ddz = d.cx - px, d.cz - py
                            if ddx * ddx + ddz * ddz < (1.3 * C) ^ 2 then near = true end
                        end
                        if not near and d.f == mf then
                            local ddx, ddz = d.cx - mx, d.cz - my
                            if ddx * ddx + ddz * ddz < (1.3 * C) ^ 2 then near = true end
                        end
                        local tgt = near and 1 or 0
                        if d.open ~= tgt then
                            local stp = dt * 4.5
                            if d.open < tgt then d.open = math.min(tgt, d.open + stp) else d.open = math.max(tgt, d.open - stp) end
                            d.panel.CFrame = d.fr * CFrame.new(d.hx, 7.3, 0) * CFrame.Angles(0, -d.sgn * d.open * 1.55, 0) * CFrame.new(-d.hx, 0, 0)
                        end
                    end

                    -- 🚪 زر "اختبئ / اطلع" قريب أي دولاب اختباء
                    do
                        local hs = H.hs
                        local nearH = nil
                        if state == "play" and not hs.on and H.hides then
                            for _, h in ipairs(H.hides) do
                                if h.ex and math.abs(h.f * FH - pElev) < FH * 0.9 then
                                    local ddx, ddz = h.ex - px, h.ez - py
                                    if ddx * ddx + ddz * ddz < (1.3 * C) ^ 2 then nearH = h break end
                                end
                            end
                        end
                        hs.near = nearH
                        local showH = (state == "play") and not hs.anim and not hs.opening and (hs.on or nearH ~= nil)
                        if showH ~= hs.vis then
                            hs.vis = showH
                            hs.btn.Visible = showH
                        end
                    end

                    -- 🗄️ زر "ادخل" قريب الدولاب
                    do
                        local nearCab = false
                        if state == "play" and not PZ.solved and math.abs(CAB.f * FH - pElev) < FH * 0.9 then
                            local cdx, cdz = CAB.x - px, CAB.z - py
                            nearCab = cdx * cdx + cdz * cdz < (1.5 * C) ^ 2
                        end
                        if nearCab ~= PZ.near then
                            PZ.near = nearCab
                            PZ.enterBtn.Visible = nearCab
                        end
                    end

                    -- 🎨 زر "العب" قريب لوحة الألوان
                    do
                        local nearCP = false
                        if state == "play" and not CP.solved and math.abs(CP.f * FH - pElev) < FH * 0.9 then
                            local cdx, cdz = CP.x - px, CP.z - py
                            nearCP = cdx * cdx + cdz * cdz < (1.5 * C) ^ 2
                        end
                        if nearCP ~= CP.near then
                            CP.near = nearCP
                            CP.enterBtn.Visible = nearCP
                        end
                    end

                    -- 🚪 الباب
                    if keysCollected >= TOTAL_KEYS and doorProg < 1 then
                        doorProg = math.min(1, doorProg + dt * 0.7)
                        doorSlab.CFrame = dBase * CFrame.new(0, 7.2 + 14.4 * doorProg, 0.15)
                        doorSlab.Transparency = doorProg
                        doorGlow.Transparency = 1 - 0.85 * doorProg
                        doorStrip.Color = Color3.fromRGB(80, 255, 140)
                        padlock.Transparency = 1
                    end

                    -- المخرج
                    if state == "play" then
                        local ed = math.sqrt((ecx - px) ^ 2 + (ecz - py) ^ 2)
                        if pf == 0 and ed < 0.6 * C then
                            if keysCollected >= TOTAL_KEYS then
                                state = "won"
                                endTimer = 0
                                moveVec = Vector2.new(0, 0)
                                knob.Position = UDim2.new(0.5, 0, 0.5, 0)
                                globalFlicker = 0
                                pcall(function() if _G.SkyGameAudio then _G.SkyGameAudio.End("horror") end end)
                            else
                                hint.Text = "لازم تجمع " .. TOTAL_KEYS .. " مفاتيح 🔑"
                                hint.Visible = true
                                hintTimer = 1.5
                            end
                        end
                        if startTimer <= 0 and md < 0.5 and not H.hs.on and not adminInvincible and not adminMonsterBlind then H.monsterHit() end
                    end

                    -- 🎬 نهاية: مسكك الوحش / هربت
                    if state == "caught" then
                        endTimer = endTimer + dt
                        caughtSFXFallback = math.max(0, caughtSFXFallback - dt)
                        mRaise = math.min(1, mRaise + dt * 5)
                        if H.hs.dying then
                            -- 😵 اختناق داخل الدولاب: الشاشة تسود بدون وجه الوحش
                            flash.BackgroundColor3 = Color3.fromRGB(8, 0, 0)
                            flash.BackgroundTransparency = math.max(0, 1 - endTimer * 0.8)
                            shake = 0.05
                            if endTimer > 1.8 then showPanel("💀 اختنقت من الخوف داخل الدولاب!", false) end
                        else
                        local show = math.clamp(endTimer * 4 - 0.2, 0, 1)
                        eyeL.Transparency, eyeR.Transparency = 1 - show, 1 - show
                        mouth.Transparency = 1 - show
                        mouth.Size = Vector3.new(0.9, 0.4 + 1.1 * show, 0.14)
                        flash.BackgroundColor3 = (math.floor(endTimer * 14) % 2 == 0) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(200, 0, 0)
                        flash.BackgroundTransparency = (endTimer < 0.5) and (0.75 + 0.2 * math.random()) or 0.93
                        shake = 0.8
                        if FL.faceUpdate then FL.faceUpdate(endTimer) end
                        -- تظهر قائمة «إعادة / خروج» بعد انتهاء صوت الموت، أو بعد مهلة احتياطية.
                        if endTimer > 1.0 and (caughtSFXFinished or caughtSFXFallback <= 0) then
                            showPanel("💀 مسكك الوحش!", false)
                        end
                        end
                    elseif state == "won" then
                        endTimer = endTimer + dt
                        flash.BackgroundColor3 = Color3.fromRGB(200, 255, 220)
                        flash.BackgroundTransparency = 1 - math.min(0.6, endTimer * 0.7)
                        if endTimer > 1.0 then showPanel("🎉 هربت! ضبطتها", true) end
                    end

                    -- ⚠️ الخوف: اهتزاز، تنبيه خطر، تشويش
                    local close = 0
                    if startTimer <= 0 and (state == "play" or state == "caught") then
                        close = math.clamp(1 - md / 5.5, 0, 1)
                    end
                    if state == "play" then
                        spotPulse = math.max(0, spotPulse - dt * 2.2)
                        shake = close * close * 0.18 + spotPulse * 0.12 + (((FL.rage or 0) > 0) and 0.16 or 0) + H.hs.halu * 0.1
                        if spotPulse > 0.01 then
                            flash.BackgroundColor3 = Color3.fromRGB(255, 40, 40)
                            flash.BackgroundTransparency = 1 - 0.4 * spotPulse
                        else
                            flash.BackgroundTransparency = 1
                        end
                        if startTimer <= 0 and md < 5 then
                            local pulse = 0.65 + 0.35 * math.sin(os.clock() * 10)
                            danger.BackgroundTransparency = 1 - MonStep.red * (1 - md / 5) * pulse
                        elseif seenNow then
                            local pulse = 0.5 + 0.5 * math.sin(os.clock() * 6)
                            danger.BackgroundTransparency = 1 - MonStep.red * 0.35 * pulse
                        else
                            danger.BackgroundTransparency = 1
                        end
                        local tr = (mState == "chase") and 0.05 or 1
                        eyeL.Transparency, eyeR.Transparency = tr, tr
                    else
                        danger.BackgroundTransparency = 1
                    end
                    noiseTimer = noiseTimer - dt
                    if noiseTimer <= 0 then
                        noiseTimer = 0.06
                        for i = 1, #noise do
                            local f = noise[i]
                            if i <= 4 and MonStep.noise > 0 and (close > 0.4 or (seenNow and state == "play")) then
                                f.Position = UDim2.new(0, 0, math.random(), 0)
                                f.Size = UDim2.new(1, 0, 0, math.random(1, 2))
                                f.BackgroundTransparency = 1 - (0.04 + MonStep.noise * math.max(close, seenNow and 0.4 or 0)) * math.random()
                            else
                                f.BackgroundTransparency = 1
                            end
                        end
                    end

                    -- 💡 اللمبات + الإضاءة
                    if globalFlicker > 0 and globalFlicker < 90 then globalFlicker = globalFlicker - dt end
                    local lampChanged = updateLamps(dt)
                    relightTimer = relightTimer - dt
                    if relightTimer <= 0 or lampChanged then
                        relightTimer = 0.045
                        relight()
                    end
                    for i = 1, #eyes do
